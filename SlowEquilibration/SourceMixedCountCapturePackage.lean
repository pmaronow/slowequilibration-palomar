private theorem pure_minDegree (p : ℕ) (hp : 2 ≤ p) (c : ℝ) (hc : 0 < c) :
    (FiniteMixture.pure p hp c hc).minDegree = p := by
  simp [FiniteMixture.minDegree, FiniteMixture.pure,
    Finsupp.support_single p hc.ne']

private theorem pure_maxDegree (p : ℕ) (hp : 2 ≤ p) (c : ℝ) (hc : 0 < c) :
    (FiniteMixture.pure p hp c hc).maxDegree = p := by
  simp [FiniteMixture.maxDegree, FiniteMixture.pure,
    Finsupp.support_single p hc.ne']

/-- The CS contact potential depends only on the temperature-weighted covariance. -/
private theorem potential_eq_of_weighted_xi_eq (μ ν : FiniteMixture) (β β' : ℝ)
    (hxi : ∀ r : ℝ, β ^ 2 * μ.xi r = β' ^ 2 * ν.xi r)
    (ζ : Measure ℝ) :
    CSStructure.potential μ β ζ = CSStructure.potential ν β' ζ := by
  funext r
  unfold CSStructure.potential CrisantiSommers.firstVariation
  rw [hxi r]

/-- Changing a pure covariance amplitude is exactly a change of temperature. -/
private theorem pure_weighted_xi (p : ℕ) (hp : 2 ≤ p) (c : ℝ) (hc : 0 < c)
    (β r : ℝ) :
    β ^ 2 * (FiniteMixture.pure p hp c hc).xi r =
      (β * Real.sqrt c) ^ 2 *
        (FiniteMixture.pure p hp 1 zero_lt_one).xi r := by
  rw [FiniteMixture.pure_xi, FiniteMixture.pure_xi, mul_pow,
    Real.sq_sqrt hc.le]
  ring

/-- The strict source certificate has the same contact and curvature after scaling. -/
private theorem pure_certificate (p : ℕ) (hp : 2 ≤ p) (c : ℝ) (hc : 0 < c)
    {β x Q : ℝ} (h : Certificate (FiniteMixture.pure p hp c hc) β x Q) :
    Certificate (FiniteMixture.pure p hp 1 zero_lt_one)
      (β * Real.sqrt c) x Q := by
  have hpot := potential_eq_of_weighted_xi_eq _ _ β (β * Real.sqrt c)
    (pure_weighted_xi p hp c hc β) (twoAtom x Q)
  refine ⟨?_, mul_pos h.beta_pos (Real.sqrt_pos.2 hc), h.weight_range,
    h.overlap_range, ?_, ?_, ?_, ?_⟩
  · simpa only [pure_minDegree] using h.min_degree
  · rw [← hpot]; exact h.contact_value
  · rw [← hpot]; exact h.contact_derivative
  · rw [← hpot]; exact h.positive_off_contact
  · rw [← hpot]; exact h.contact_curvature

/-- Reindexing the maximal degree identifies the same independent Gaussian tensors. -/
private def disorderEquiv {N P R : ℕ} (hPR : P = R) :
    Disorder N P ≃ᵐ Disorder N R := by
  subst R
  exact MeasurableEquiv.refl _

private theorem disorderEquiv_measurePreserving {N P R : ℕ} (hPR : P = R) :
    MeasurePreserving (disorderEquiv (N := N) hPR)
      (disorderLaw N P) (disorderLaw N R) := by
  subst R
  exact MeasurePreserving.id _

private theorem field_scale {N P : ℕ} (a : ℝ) (ha : 0 ≤ a)
    (c : Degree P → ℝ) (J : Disorder N P) (u : Vector N) :
    field (fun d => a * c d) J u = Real.sqrt a * field c J u := by
  unfold field
  simp_rw [Real.sqrt_mul ha]
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro d _
  ring

/-- Pure amplitudes use precisely the same disorder after identifying their degrees. -/
private def pureDisorderEquiv (N p : ℕ) (hp : 2 ≤ p) (c : ℝ) (hc : 0 < c) :
    Disorder N (FiniteMixture.pure p hp c hc).maxDegree ≃ᵐ
      Disorder N (FiniteMixture.pure p hp 1 zero_lt_one).maxDegree :=
  disorderEquiv ((pure_maxDegree p hp c hc).trans
    (pure_maxDegree p hp 1 zero_lt_one).symm)

private theorem field_scale_reindex {N P R : ℕ} (hPR : P = R)
    (a : ℝ) (ha : 0 ≤ a) (c : Degree P → ℝ) (d : Degree R → ℝ)
    (hcd : ∀ k : ℕ, ∀ (hkP : k < P + 1) (hkR : k < R + 1) (hk : 2 ≤ k),
      c ⟨⟨k, hkP⟩, hk⟩ = a * d ⟨⟨k, hkR⟩, hk⟩)
    (J : Disorder N P) (u : Vector N) :
    field c J u = Real.sqrt a * field d (disorderEquiv hPR J) u := by
  subst R
  have heq : c = fun k => a * d k := by
    funext k
    exact hcd k.val.val k.val.isLt k.val.isLt k.property
  rw [heq]
  exact field_scale a ha d J u

/-- Pathwise amplitude scaling of the literal original Hamiltonian. -/
private theorem pure_field (N p : ℕ) (hp : 2 ≤ p) (c : ℝ) (hc : 0 < c)
    (J : Disorder N (FiniteMixture.pure p hp c hc).maxDegree) (u : Vector N) :
    field (mixtureCoefficients (FiniteMixture.pure p hp c hc)) J u =
      Real.sqrt c *
        field (mixtureCoefficients (FiniteMixture.pure p hp 1 zero_lt_one))
          (pureDisorderEquiv N p hp c hc J) u := by
  apply field_scale_reindex _ c hc.le
  intro k _ _ _
  by_cases hk : k = p <;>
    simp [mixtureCoefficients, FiniteMixture.pure, hk]

/-- The ordinary CS functional is unchanged by weighted covariance equality. -/
private theorem functional_eq_of_weighted_xi_eq (μ ν : FiniteMixture) (β β' : ℝ)
    (hxi : ∀ r : ℝ, β ^ 2 * μ.xi r = β' ^ 2 * ν.xi r)
    (ζ : Measure ℝ) (q : ℝ) :
    CrisantiSommers.functional β μ.xi ζ q = CrisantiSommers.functional β' ν.xi ζ q := by
  have hi : β ^ 2 * (∫ s, μ.xi s ∂ζ) = β' ^ 2 * (∫ s, ν.xi s ∂ζ) := by
    rw [← integral_const_mul, ← integral_const_mul]
    exact integral_congr_ae (.of_forall hxi)
  unfold CrisantiSommers.functional
  rw [mul_sub, mul_sub, hxi 1, hi]

/-- The variational pressure is unchanged by exact covariance-temperature scaling. -/
private theorem variationalValue_eq_of_weighted_xi_eq (μ ν : FiniteMixture) (β β' : ℝ)
    (hxi : ∀ r : ℝ, β ^ 2 * μ.xi r = β' ^ 2 * ν.xi r) :
    CSParisiMeasure.variationalValue μ β = CSParisiMeasure.variationalValue ν β' := by
  have hv (ζ : Admissible) : ζ.value β μ.xi = ζ.value β' ν.xi :=
    functional_eq_of_weighted_xi_eq μ ν β β' hxi ζ.law ζ.cutoff
  apply le_antisymm
  · exact (CSParisiMeasure.canonicalMinimizer_isMinimizer μ β _).trans_eq
      (hv (CSParisiMeasure.canonicalMinimizer ν β'))
  · exact (CSParisiMeasure.canonicalMinimizer_isMinimizer ν β' _).trans_eq
      (hv (CSParisiMeasure.canonicalMinimizer μ β)).symm

private theorem pure_xi1_scale (p : ℕ) (hp : 2 ≤ p) (c : ℝ) (hc : 0 < c)
    (r : ℝ) :
    (FiniteMixture.pure p hp c hc).xi1 r =
      c * (FiniteMixture.pure p hp 1 zero_lt_one).xi1 r := by
  simp [FiniteMixture.xi1, FiniteMixture.pure, Finsupp.support_single p hc.ne',
    mul_assoc]

private theorem pure_xi2_scale (p : ℕ) (hp : 2 ≤ p) (c : ℝ) (hc : 0 < c)
    (r : ℝ) :
    (FiniteMixture.pure p hp c hc).xi2 r =
      c * (FiniteMixture.pure p hp 1 zero_lt_one).xi2 r := by
  simp [FiniteMixture.xi2, FiniteMixture.curvatureCoeff, FiniteMixture.pure,
    Finsupp.support_single p hc.ne', mul_assoc]

/-- The energy mark scales by the positive field amplitude. -/
private theorem pure_markE (p : ℕ) (hp : 2 ≤ p) (c : ℝ) (hc : 0 < c)
    (β x Q : ℝ) :
    markE (FiniteMixture.pure p hp c hc) β x Q =
      Real.sqrt c * markE (FiniteMixture.pure p hp 1 zero_lt_one)
        (β * Real.sqrt c) x Q := by
  unfold markE markA markY
  rw [pure_xi1_scale, FiniteMixture.pure_xi, FiniteMixture.pure_xi]
  simp only [div_eq_mul_inv, mul_inv_rev, inv_inv, one_mul]
  ring_nf
  rw [Real.sq_sqrt hc.le]
  ring

/-- The radial mark scales by the same positive field amplitude. -/
private theorem pure_markK (p : ℕ) (hp : 2 ≤ p) (c : ℝ) (hc : 0 < c)
    (β Q : ℝ) :
    markK (FiniteMixture.pure p hp c hc) β Q =
      Real.sqrt c * markK (FiniteMixture.pure p hp 1 zero_lt_one)
        (β * Real.sqrt c) Q := by
  unfold markK markB markY
  rw [pure_xi2_scale]
  field_simp
  rw [Real.sq_sqrt hc.le]
  ring

/-- The printed logarithmic center scales exactly, including its logarithmic term. -/
private theorem sourcePureAnalyticCenter_scale (N : ℕ) (E t s : ℝ) (hs : s ≠ 0) :
    sourcePureAnalyticCenter N (s * E) t =
      s * sourcePureAnalyticCenter N E (t * s) := by
  unfold sourcePureAnalyticCenter
  field_simp

private theorem gibbsLaw_eq_of_weighted_field_eq {N : ℕ}
    (β β' : ℝ) (H H' : Vector N → ℝ)
    (hH : ∀ u, β * H u = β' * H' u) :
    gibbsLaw N β H = gibbsLaw N β' H' := by
  have hp : partition N β H = partition N β' H' := by
    unfold partition
    simp_rw [hH]
  simp only [gibbsLaw, gibbsDensity, hp, hH]

/-- The Gibbs measures agree on each common realization of the Gaussian tensors. -/
private theorem pure_gibbsLaw (N p : ℕ) (hp : 2 ≤ p) (c : ℝ) (hc : 0 < c)
    (β : ℝ) (J : Disorder N (FiniteMixture.pure p hp c hc).maxDegree) :
    mixtureGibbsLaw (FiniteMixture.pure p hp c hc) β J =
      mixtureGibbsLaw (FiniteMixture.pure p hp 1 zero_lt_one)
        (β * Real.sqrt c) (pureDisorderEquiv N p hp c hc J) := by
  apply gibbsLaw_eq_of_weighted_field_eq
  intro u
  unfold fieldOfMixture
  rw [pure_field]
  ring

private theorem replica_law_transport
    {Ω Ω' V : Type*} [MeasurableSpace Ω] [MeasurableSpace Ω'] [MeasurableSpace V]
    (d : Measure Ω) (d' : Measure Ω')
    (G : Kernel Ω V) (G' : Kernel Ω' V)
    [IsMarkovKernel G] [IsMarkovKernel G']
    (f : Ω → Ω') (hf : MeasurePreserving f d d')
    (hG : ∀ ω, G ω = G' (f ω)) (m : ℕ) :
    GaussianReplicaKernel.law d G m = GaussianReplicaKernel.law d' G' m := by
  apply Measure.ext
  intro s hs
  change (Measure.bind d (GaussianReplicaKernel.iid G m)) s =
    (Measure.bind d' (GaussianReplicaKernel.iid G' m)) s
  rw [Measure.bind_apply hs (GaussianReplicaKernel.iid G m).aemeasurable,
    Measure.bind_apply hs (GaussianReplicaKernel.iid G' m).aemeasurable]
  calc
    _ = ∫⁻ ω, GaussianReplicaKernel.iid G' m (f ω) s ∂d := by
      apply lintegral_congr
      intro ω
      rw [GaussianReplicaKernel.iid_apply, GaussianReplicaKernel.iid_apply, hG ω]
    _ = _ := hf.lintegral_comp ((GaussianReplicaKernel.iid G' m).measurable_coe hs)

private theorem pure_replica_law (N k p : ℕ) (hp : 2 ≤ p) (c : ℝ) (hc : 0 < c)
    (β : ℝ) :
    GaussianReplicaKernel.law (disorderLaw N (FiniteMixture.pure p hp c hc).maxDegree)
      (allDimensionGibbsKernel (mixtureCoefficients (FiniteMixture.pure p hp c hc)) β) k =
    GaussianReplicaKernel.law
      (disorderLaw N (FiniteMixture.pure p hp 1 zero_lt_one).maxDegree)
      (allDimensionGibbsKernel
        (mixtureCoefficients (FiniteMixture.pure p hp 1 zero_lt_one))
        (β * Real.sqrt c)) k := by
  apply replica_law_transport _ _ _ _ (pureDisorderEquiv N p hp c hc)
    (disorderEquiv_measurePreserving _)
  intro J
  rw [allDimensionGibbsKernel_apply, allDimensionGibbsKernel_apply]
  apply gibbsLaw_eq_of_weighted_field_eq
  intro u
  rw [pure_field]
  ring

private theorem pure_physicalFullOverlapLaw (n m p : ℕ) (hp : 2 ≤ p)
    (c : ℝ) (hc : 0 < c) (β : ℝ) :
    physicalFullOverlapLaw (n := n) (m := m) (FiniteMixture.pure p hp c hc) β =
      physicalFullOverlapLaw (n := n) (m := m) (FiniteMixture.pure p hp 1 zero_lt_one)
        (β * Real.sqrt c) := by
  have hlaw : physicalReplicaLaw (n := n) (m := m) (FiniteMixture.pure p hp c hc) β =
      physicalReplicaLaw (n := n) (m := m) (FiniteMixture.pure p hp 1 zero_lt_one)
        (β * Real.sqrt c) := pure_replica_law (n+2) m p hp c hc β
  unfold physicalFullOverlapLaw
  exact congrArg
    (fun v : ProbabilityMeasure (Fin m → Vector (n+2)) =>
      v.map physicalFullOverlapCoordinates)
    ((Measure.toProbabilityMeasure_inj _ _).2 hlaw)

private theorem pure_directingNorm (p : ℕ) (hp : 2 ≤ p)
    (c : ℝ) (hc : 0 < c) (β Q : ℝ)
    (hnorm : PhysicalDirectingNormQ (FiniteMixture.pure p hp c hc) β Q) :
    PhysicalDirectingNormQ (FiniteMixture.pure p hp 1 zero_lt_one)
      (β * Real.sqrt c) Q := by
  have harray : physicalFullOverlapLawArray (FiniteMixture.pure p hp c hc) β =
      physicalFullOverlapLawArray (FiniteMixture.pure p hp 1 zero_lt_one)
        (β * Real.sqrt c) := by
    funext n m
    exact pure_physicalFullOverlapLaw n m p hp c hc β
  have hset : physicalFullAsymptoticLimitSet (FiniteMixture.pure p hp c hc) β =
      physicalFullAsymptoticLimitSet (FiniteMixture.pure p hp 1 zero_lt_one)
        (β * Real.sqrt c) := by
    unfold physicalFullAsymptoticLimitSet
    rw [harray]
  unfold PhysicalDirectingNormQ at *
  rwa [hset] at hnorm

private theorem replicatedBandPressure_eq_of_field_identification
    (μ ν : FiniteMixture) (β β' : ℝ) {N : ℕ}
    (e : Disorder N μ.maxDegree ≃ᵐ Disorder N ν.maxDegree)
    (hH : ∀ J u, β * field (mixtureCoefficients μ) J u =
      β' * field (mixtureCoefficients ν) (e J) u)
    (k : ℕ) (q δ ρ : ℝ) (J : Disorder N μ.maxDegree) (m : Vector N) :
    replicatedBandPressure k μ β q δ ρ J m =
      replicatedBandPressure k ν β' q δ ρ (e J) m := by
  have hp : replicatedBandPartition k μ β q δ ρ J m =
      replicatedBandPartition k ν β' q δ ρ (e J) m := by
    unfold replicatedBandPartition
    apply integral_congr_ae
    filter_upwards [] with σ
    congr 1
    simp only [Finset.mul_sum, mul_sub]
    apply Finset.sum_congr rfl
    intro i _
    rw [hH J (σ i), hH J m]
  unfold replicatedBandPressure
  rw [hp]

private theorem expectedReplicatedBandPressure_eq_of_field_identification
    (μ ν : FiniteMixture) (β β' : ℝ) {N : ℕ}
    (e : Disorder N μ.maxDegree ≃ᵐ Disorder N ν.maxDegree)
    (hE : MeasurePreserving e (disorderLaw N μ.maxDegree) (disorderLaw N ν.maxDegree))
    (hH : ∀ J u, β * field (mixtureCoefficients μ) J u =
      β' * field (mixtureCoefficients ν) (e J) u)
    (k : ℕ) (q δ ρ : ℝ) (m : Vector N) :
    expectedReplicatedBandPressure k μ β q δ ρ m =
      expectedReplicatedBandPressure k ν β' q δ ρ m := by
  unfold expectedReplicatedBandPressure
  calc
    _ = ∫ J, replicatedBandPressure k ν β' q δ ρ (e J) m
        ∂disorderLaw N μ.maxDegree :=
      integral_congr_ae (.of_forall fun J =>
        replicatedBandPressure_eq_of_field_identification μ ν β β' e hH k q δ ρ J m)
    _ = _ := hE.integral_comp' (fun J => replicatedBandPressure k ν β' q δ ρ J m)

private theorem uniformDeviationEvent_eq_preimage_of_field_identification
    (μ ν : FiniteMixture) (β β' : ℝ) {N : ℕ}
    (e : Disorder N μ.maxDegree ≃ᵐ Disorder N ν.maxDegree)
    (hE : MeasurePreserving e (disorderLaw N μ.maxDegree) (disorderLaw N ν.maxDegree))
    (hH : ∀ J u, β * field (mixtureCoefficients μ) J u =
      β' * field (mixtureCoefficients ν) (e J) u)
    (k : ℕ) (q δ ρ t : ℝ) :
    uniformDeviationEvent k μ β q δ ρ t =
      e ⁻¹' uniformDeviationEvent k ν β' q δ ρ t := by
  ext J
  simp only [uniformDeviationEvent, Set.mem_ofPred_eq, Set.mem_preimage]
  simp_rw [replicatedBandPressure_eq_of_field_identification μ ν β β' e hH,
    expectedReplicatedBandPressure_eq_of_field_identification μ ν β β' e hE hH]

private theorem proposition24_of_field_identification
    (μ ν : FiniteMixture) (β β' q : ℝ) (hβ' : 0 < β')
    (e : ∀ N, Disorder N μ.maxDegree ≃ᵐ Disorder N ν.maxDegree)
    (hE : ∀ N, MeasurePreserving (e N) (disorderLaw N μ.maxDegree)
      (disorderLaw N ν.maxDegree))
    (hH : ∀ N J u, β * field (mixtureCoefficients μ) J u =
      β' * field (mixtureCoefficients ν) (e N J) u)
    (h24 : Proposition24 μ β q) : Proposition24 ν β' q := by
  refine ⟨hβ', h24.2.1, ?_⟩
  intro t c ht hc
  obtain ⟨δ₀, hδ₀, ρ₀, hρ₀, k₀, h24⟩ := h24.2.2 t c ht hc
  refine ⟨δ₀, hδ₀, ρ₀, hρ₀, k₀, ?_⟩
  intro δ hδ hδ₀' ρ hρ hρ₀' k hk N hN
  obtain ⟨hm, hp⟩ := h24 δ hδ hδ₀' ρ hρ hρ₀' k hk N hN
  have hev := uniformDeviationEvent_eq_preimage_of_field_identification
    μ ν β β' (e N) (hE N) (hH N) k q δ ρ t
  rw [hev] at hm hp
  refine ⟨(e N).measurableSet_preimage.mp hm, ?_⟩
  have hreal : (disorderLaw N μ.maxDegree).real
      ((e N) ⁻¹' uniformDeviationEvent k ν β' q δ ρ t) =
      (disorderLaw N ν.maxDegree).real (uniformDeviationEvent k ν β' q δ ρ t) :=
    congrArg ENNReal.toReal ((hE N).measure_preimage_equiv _)
  rwa [hreal] at hp

private theorem pure_proposition24 (p : ℕ) (hp : 2 ≤ p) (c : ℝ) (hc : 0 < c)
    {β Q : ℝ} (h24 : Proposition24 (FiniteMixture.pure p hp c hc) β Q) :
    Proposition24 (FiniteMixture.pure p hp 1 zero_lt_one) (β * Real.sqrt c) Q := by
  apply proposition24_of_field_identification _ _ β (β * Real.sqrt c) Q
    (mul_pos h24.1 (Real.sqrt_pos.2 hc)) (fun N => pureDisorderEquiv N p hp c hc)
    (fun _ => disorderEquiv_measurePreserving _) _ h24
  intro N J u
  rw [pure_field]
  ring

private theorem pure_center_field (N p : ℕ) (hp : 2 ≤ p) (c : ℝ) (hc : 0 < c)
    {Q : ℝ} (hQ : 0 ≤ Q)
    (J : Disorder N (FiniteMixture.pure p hp c hc).maxDegree) (u : Vector N) :
    field (centerCoefficients (mixtureCoefficients (FiniteMixture.pure p hp c hc)) Q) J u =
      Real.sqrt c * field (centerCoefficients
        (mixtureCoefficients (FiniteMixture.pure p hp 1 zero_lt_one)) Q)
        (pureDisorderEquiv N p hp c hc J) u := by
  rw [field_center_scale _ (mixtureCoefficients_nonnegative _) hQ,
    field_center_scale _ (mixtureCoefficients_nonnegative _) hQ]
  exact pure_field N p hp c hc J _

private theorem pure_center_gradient (N p : ℕ) (hp : 2 ≤ p) (c : ℝ) (hc : 0 < c)
    {Q : ℝ} (hQ : 0 ≤ Q)
    (J : Disorder N (FiniteMixture.pure p hp c hc).maxDegree) (u : Vector N) :
    surfaceGradient
      (field (centerCoefficients (mixtureCoefficients (FiniteMixture.pure p hp c hc)) Q) J) u =
      Real.sqrt c • surfaceGradient
        (field (centerCoefficients
          (mixtureCoefficients (FiniteMixture.pure p hp 1 zero_lt_one)) Q)
          (pureDisorderEquiv N p hp c hc J)) u := by
  rw [funext (pure_center_field N p hp c hc hQ J)]
  apply ext_inner_right ℝ
  intro v
  rw [inner_surfaceGradient, real_inner_smul_left, inner_surfaceGradient,
    fderiv_const_mul ((field_contDiff _ _).differentiable (by simp) u)]
  rfl

private theorem pure_center_radial (N p : ℕ) (hp : 2 ≤ p) (c : ℝ) (hc : 0 < c)
    {Q : ℝ} (hQ : 0 ≤ Q)
    (J : Disorder N (FiniteMixture.pure p hp c hc).maxDegree) (u : Vector N) :
    actualScore (centerCoefficients
      (mixtureCoefficients (FiniteMixture.pure p hp c hc)) Q) J u 1 =
      Real.sqrt c * actualScore (centerCoefficients
        (mixtureCoefficients (FiniteMixture.pure p hp 1 zero_lt_one)) Q)
        (pureDisorderEquiv N p hp c hc J) u 1 := by
  rw [pure_actualScore_radial_eq_value, pure_actualScore_radial_eq_value]
  unfold actualValue
  rw [pure_center_field N p hp c hc hQ]
  ring

private theorem scaled_mem_image {s v : ℝ} (hs : s ≠ 0) (U : Set ℝ) :
    s * v ∈ (fun k => s * k) '' U ↔ v ∈ U := by
  constructor
  · rintro ⟨k, hk, he⟩
    rwa [(mul_left_cancel₀ hs he : k = v)] at hk
  · intro hv
    exact ⟨v, hv, rfl⟩

private theorem pure_windowCenter (N p : ℕ) (hp : 2 ≤ p) (c : ℝ) (hc : 0 < c)
    {Q : ℝ} (hQ : 0 ≤ Q) (m M : ℝ) (U : Set ℝ)
    (J : Disorder N (FiniteMixture.pure p hp c hc).maxDegree) (u : Vector N) :
    (J, u) ∈ windowCenterGraph (FiniteMixture.pure p hp c hc) Q
      (Real.sqrt c * m) (Real.sqrt c * M) ((fun k => Real.sqrt c * k) '' U) ↔
    (pureDisorderEquiv N p hp c hc J, u) ∈
      windowCenterGraph (FiniteMixture.pure p hp 1 zero_lt_one) Q m M U := by
  have hs : 0 < Real.sqrt c := Real.sqrt_pos.2 hc
  unfold windowCenterGraph
  simp only [Set.mem_inter_iff, Set.mem_ofPred_eq]
  rw [pure_center_gradient N p hp c hc hQ, pure_center_field N p hp c hc hQ,
    pure_center_radial N p hp c hc hQ]
  simp only [smul_eq_zero, hs.ne', false_or, scaled_mem_image hs.ne']
  rw [← mul_sub, ← mul_add]
  simp only [Set.mem_Icc, mul_le_mul_iff_right₀ hs]

private theorem pure_bandUnion (N p : ℕ) (hp : 2 ≤ p) (c : ℝ) (hc : 0 < c)
    {Q : ℝ} (hQ : 0 ≤ Q) (m M b : ℝ) (U : Set ℝ)
    (J : Disorder N (FiniteMixture.pure p hp c hc).maxDegree) :
    ambientWindowBandUnion (FiniteMixture.pure p hp c hc) Q
      (Real.sqrt c * m) (Real.sqrt c * M) b ((fun k => Real.sqrt c * k) '' U) J =
    ambientWindowBandUnion (FiniteMixture.pure p hp 1 zero_lt_one) Q m M b U
      (pureDisorderEquiv N p hp c hc J) := by
  ext u
  unfold ambientWindowBandUnion physicalSphereBandUnionGraph bandUnionGraph
    SourceReductionCompactBandProjection.bandUnionGraph
  simp only [Set.mem_ofPred_eq, Set.mem_inter_iff]
  simp_rw [pure_windowCenter N p hp c hc hQ]

private theorem pure_complementMass (N p : ℕ) (hp : 2 ≤ p) (c : ℝ) (hc : 0 < c)
    {Q : ℝ} (hQ : 0 ≤ Q) (m M b β : ℝ) (U : Set ℝ)
    (J : Disorder N (FiniteMixture.pure p hp c hc).maxDegree) :
    originalBandComplementMass (FiniteMixture.pure p hp c hc) Q
      (Real.sqrt c * m) (Real.sqrt c * M) b β ((fun k => Real.sqrt c * k) '' U) J =
    originalBandComplementMass (FiniteMixture.pure p hp 1 zero_lt_one) Q
      m M b (β * Real.sqrt c) U (pureDisorderEquiv N p hp c hc J) := by
  unfold originalBandComplementMass
  rw [pure_gibbsLaw, pure_bandUnion N p hp c hc hQ]

private theorem pure_expected_complementMass (N p : ℕ) (hp : 2 ≤ p)
    (c : ℝ) (hc : 0 < c) {Q : ℝ} (hQ : 0 ≤ Q) (m M b β : ℝ) (U : Set ℝ) :
    (∫ J, originalBandComplementMass (FiniteMixture.pure p hp c hc) Q
      (Real.sqrt c * m) (Real.sqrt c * M) b β ((fun k => Real.sqrt c * k) '' U) J
      ∂disorderLaw N (FiniteMixture.pure p hp c hc).maxDegree) =
    ∫ J, originalBandComplementMass (FiniteMixture.pure p hp 1 zero_lt_one) Q
      m M b (β * Real.sqrt c) U J
      ∂disorderLaw N (FiniteMixture.pure p hp 1 zero_lt_one).maxDegree := by
  simp_rw [pure_complementMass N p hp c hc hQ]
  have hE : MeasurePreserving (pureDisorderEquiv N p hp c hc)
      (disorderLaw N (FiniteMixture.pure p hp c hc).maxDegree)
      (disorderLaw N (FiniteMixture.pure p hp 1 zero_lt_one).maxDegree) :=
    disorderEquiv_measurePreserving _
  exact hE.integral_comp'
    (fun J => originalBandComplementMass (FiniteMixture.pure p hp 1 zero_lt_one) Q
      m M b (β * Real.sqrt c) U J)


private def PureAllWidths (μ : FiniteMixture) (β x Q : ℝ) : Prop :=
  ∃ L R b₀ : ℝ, sourceRadialEdge μ Q < L ∧ L < markK μ β Q ∧
    markK μ β Q < R ∧ 0 < b₀ ∧ b₀ < Real.sqrt Q ∧
    ∀ b : ℝ, 0 < b → b ≤ b₀ →
      Tendsto (fun M : ℝ => limsup (fun n : ℕ => ∫ J,
        originalBandComplementMass μ Q
          (sourcePureAnalyticCenter (n+2) (markE μ β x Q) (β*x))
          M b β (Icc L R) J ∂disorderLaw (n+2) μ.maxDegree) atTop) atTop (𝓝 0)

private theorem amplitude_one_capture_of_norm_and_proposition24
    (p : ℕ) (hp : 4 ≤ p) {β x Q : ℝ}
    (h : Certificate (FiniteMixture.pure p (by omega) 1 zero_lt_one) β x Q)
    (hChen : Chen2013FiniteParisi)
    (hnorm : PhysicalDirectingNormQ (FiniteMixture.pure p (by omega) 1 zero_lt_one) β Q)
    (h24 : Proposition24 (FiniteMixture.pure p (by omega) 1 zero_lt_one) β Q) :
    PureAllWidths (FiniteMixture.pure p (by omega) 1 zero_lt_one) β x Q := by
  let μ := FiniteMixture.pure p (by omega : 2 ≤ p) 1 zero_lt_one
  let K := markK μ β Q
  let edge := 2 * Real.sqrt (Q ^ 2 * μ.xi2 Q)
  let δ := (K - edge) / 2
  have hδ : 0 < δ := by
    have hh := h.edge_margin.2.2
    change 0 < K - edge at hh
    exact half_pos hh
  let U := Icc (K - δ) (K + δ)
  have hcontact : markK μ β Q ∈ interior U := by
    rw [show U = Icc (K - δ) (K + δ) from rfl, interior_Icc]
    exact ⟨by linarith, by linarith⟩
  have hgap : ∀ k ∈ U, 2 * Real.sqrt (Q ^ 2 * μ.xi2 Q) < k := by
    intro k hk
    have hh := hk.1
    change K - δ ≤ k at hh
    change edge < k
    dsimp only [δ] at hδ hh
    linarith
  obtain ⟨⟨b, hb, hcapture⟩, _⟩ :=
    SourcePureCaptureLiteralConsumer.pure_consumer_capture_of_three_physical_inputs
      p hp h U hcontact hnorm
      (PureReplicaMeanEnergyAssembly.pure_physicalReplicaMeanEnergy_of_literature p hp h hChen h24)
      (PurePhysicalHighEnergyRelocation.pure_physicalHighEnergyRelocation p hp)
  refine ⟨K-δ, K+δ, b, hgap (K-δ) ⟨le_rfl, by linarith⟩,
    by change K-δ < K; linarith, by change K < K+δ; linarith, hb.1, hb.2, ?_⟩
  intro b' hb' hbb'
  have hh := hcapture b' ⟨hb', hbb'⟩
  change Tendsto (fun M : ℝ => limsup (fun n : ℕ =>
    ∫ J, originalBandComplementMass μ Q
      ((Real.sqrt Q) ^ p * SourcePureCaptureFixedCapEstimates.pureSourceCenter p hp n)
      M b' β U J ∂disorderLaw (n+2) μ.maxDegree) atTop) atTop (𝓝 0) at hh
  simp_rw [SourcePureCaptureLiteralConsumer.pure_source_consumer_center_eq p hp h] at hh
  exact hh


private theorem pure_all_widths_of_literature
    (p : ℕ) (hp : 2 ≤ p) (c : ℝ) (hc : 0 < c)
    {β x Q : ℝ} (h : Certificate (FiniteMixture.pure p hp c hc) β x Q)
    (hChen : Chen2013FiniteParisi) (hChenSen : ChenSenFiniteGround)
    (h5 : Theorem5 (literatureThermodynamicData hChen hChenSen (FiniteMixture.pure p hp c hc) h.beta_pos.le))
    (h25 : Remark25Contrapositive (FiniteMixture.pure p hp c hc) β)
    (h24 : Proposition24 (FiniteMixture.pure p hp c hc) β Q) :
    PureAllWidths (FiniteMixture.pure p hp c hc) β x Q := by
  have hp4 : 4 ≤ p := by simpa only [pure_minDegree] using h.min_degree
  have h1 := pure_certificate p hp c hc h
  have hnorm := pure_directingNorm p hp c hc β Q
    (SourceLiteraturePhysicalNormQ.physicalDirectingNormQ_of_cited_theorems
      hChen hChenSen h h5 h25)
  obtain ⟨L, R, b₀, hEdge, hL, hR, hb₀, hb₀Q, hcapture⟩ :=
    amplitude_one_capture_of_norm_and_proposition24 p hp4 h1 hChen hnorm
      (pure_proposition24 p hp c hc h24)
  have hs : 0 < Real.sqrt c := Real.sqrt_pos.2 hc
  have he : sourceRadialEdge (FiniteMixture.pure p hp c hc) Q =
      Real.sqrt c * sourceRadialEdge (FiniteMixture.pure p hp 1 zero_lt_one) Q := by
    unfold sourceRadialEdge
    rw [pure_xi2_scale, show Q^2 * (c * (FiniteMixture.pure p hp 1 zero_lt_one).xi2 Q) =
      c * (Q^2 * (FiniteMixture.pure p hp 1 zero_lt_one).xi2 Q) by ring,
      Real.sqrt_mul hc.le]
    ring
  refine ⟨Real.sqrt c*L, Real.sqrt c*R, b₀, ?_, ?_, ?_, hb₀, hb₀Q, ?_⟩
  · rw [he]; exact mul_lt_mul_of_pos_left hEdge hs
  · rw [pure_markK]; exact mul_lt_mul_of_pos_left hL hs
  · rw [pure_markK]; exact mul_lt_mul_of_pos_left hR hs
  · intro b hb hbb
    have hcenter (N : ℕ) :
        sourcePureAnalyticCenter N (markE (FiniteMixture.pure p hp c hc) β x Q) (β*x) =
          Real.sqrt c * sourcePureAnalyticCenter N
            (markE (FiniteMixture.pure p hp 1 zero_lt_one) (β*Real.sqrt c) x Q)
            ((β*Real.sqrt c)*x) := by
      rw [pure_markE, sourcePureAnalyticCenter_scale N _ _ _ hs.ne']
      congr 2
      ring
    apply ((hcapture b hb hbb).comp (tendsto_id.atTop_div_const hs)).congr'
    filter_upwards [] with M
    apply Filter.limsup_congr
    filter_upwards [] with n
    rw [hcenter]
    have heq := pure_expected_complementMass (n+2) p hp c hc h.overlap_range.1.le
      (sourcePureAnalyticCenter (n+2)
        (markE (FiniteMixture.pure p hp 1 zero_lt_one) (β*Real.sqrt c) x Q)
        ((β*Real.sqrt c)*x)) (M/Real.sqrt c) b β (Icc L R)
    rw [show Real.sqrt c*(M/Real.sqrt c) = M by field_simp,
      image_mul_left_Icc' hs] at heq
    exact heq.symm

private theorem score_count_nonzero_nonempty
    (n : ℕ) (μ : FiniteMixture) (Q l r : ℝ) (U : Set ℝ)
    (J : Disorder (n+3) μ.maxDegree)
    (hcount : actualScoreWindowCount (n+2)
      (centerCoefficients (mixtureCoefficients μ) Q)
      (physicalEnergyWindow (n+3) (Icc l r) U) (fun _ _ => 1) J ≠ 0) :
    Set.Nonempty {u : Vector (n+3) | ‖u‖^2 = (n+3 : ℕ) ∧
      surfaceGradient (field (centerCoefficients (mixtureCoefficients μ) Q) J) u = 0 ∧
      field (centerCoefficients (mixtureCoefficients μ) Q) J u ∈ Icc l r ∧
      actualScore (centerCoefficients (mixtureCoefficients μ) Q) J u 1 ∈ U} := by
  let A : Set (Vector (n+3)) := {u | ‖u‖^2 = (n+3 : ℕ) ∧
    surfaceGradient (field (centerCoefficients (mixtureCoefficients μ) Q) J) u = 0 ∧
    actualScore (centerCoefficients (mixtureCoefficients μ) Q) J u ∈
      physicalEnergyWindow (n+3) (Icc l r) U}
  have hA : A.Nonempty := by
    by_contra hne
    have he : A = ∅ := Set.not_nonempty_iff_eq_empty.mp hne
    apply hcount
    change (∑' _ : A, (1 : ℝ≥0∞)) = 0
    rw [he]
    exact tsum_empty
  obtain ⟨u, hu⟩ := hA
  exact ⟨u, hu.1, hu.2.1,
    (actualScore_mem_physicalEnergyWindow (by omega) _ J u (Icc l r) U).mp hu.2.2⟩

private theorem pure_count_capture_package_of_literature
    (μ : FiniteMixture) {β x Q : ℝ}
    (h : Certificate μ β x Q) (hnp : ¬ μ.minDegree < μ.maxDegree)
    (hChen : Chen2013FiniteParisi) (hChenSen : ChenSenFiniteGround)
    (h5 : Theorem5 (literatureThermodynamicData hChen hChenSen μ h.beta_pos.le))
    (h25 : Remark25Contrapositive μ β) (h24 : Proposition24 μ β Q) :
    ∃ L R b₀ : ℝ, sourceRadialEdge μ Q < L ∧ L < markK μ β Q ∧
      markK μ β Q < R ∧ 0 < b₀ ∧ b₀ < Real.sqrt Q ∧
      CountCapturePackage μ β x Q L R b₀
        (fun n => sourcePureAnalyticCenter (n+2) (markE μ β x Q) (β*x)) := by
  obtain ⟨p, hp, c, hc, hμ⟩ :=
    SourceConditionedCPTransfer.pure_representation_of_not_nonpure μ hnp
  subst μ
  let μ := FiniteMixture.pure p hp c hc
  obtain ⟨L, R, b₀, hEdge, hL, hR, hb₀, hb₀Q, hcapture⟩ :=
    pure_all_widths_of_literature p hp c hc h hChen hChenSen h5 h25 h24
  have hcontact : markK μ β Q ∈ interior (Icc L R) := by
    rw [interior_Icc]; exact ⟨hL, hR⟩
  obtain ⟨hcount, hground, _⟩ :=
    sourcePure_prop_pc_counts_literal p hp c hc h (Icc L R) measurableSet_Icc hcontact
  refine ⟨L, R, b₀, hEdge, hL, hR, hb₀, hb₀Q, ?_⟩
  refine ⟨SourceConditionedCPTransferPureConsumer.sourcePureAnalyticCenter_normalized_tendsto
    (markE μ β x Q) (β*x), ?_, ?_, ?_, hcapture⟩
  · refine ⟨1, by norm_num, .of_forall fun n => ?_⟩
    simp only [sourcePureAnalyticCenter, sub_self, abs_zero, zero_le_one]
  · intro M hM
    obtain ⟨B, hB⟩ := hcount M hM
    refine ⟨max B 1, lt_of_lt_of_le zero_lt_one (le_max_right _ _), fun n => ?_⟩
    obtain ⟨hf, hv⟩ := hB n
    have hh := ENNReal.ofReal_le_ofReal (hv.trans (le_max_left B 1))
    rw [ENNReal.ofReal_toReal hf.ne] at hh
    exact hh
  · apply hground.squeeze' tendsto_const_nhds
    · exact .of_forall fun M => Filter.liminf_le_liminf
        (.of_forall fun n => measureReal_mono (fun J hJ =>
          ⟨score_count_nonzero_nonempty n μ Q _ _ (Icc L R) J hJ.1, hJ.2⟩)
          (measure_ne_top _ _))
        (isBoundedUnder_of ⟨0, fun _ => measureReal_nonneg⟩)
        (isBoundedUnder_of ⟨(1 : ℝ), fun _ => measureReal_le_one⟩).isCoboundedUnder_ge
    · exact .of_forall fun M => liminf_le_of_le
        (isBoundedUnder_of ⟨0, fun _ => measureReal_nonneg⟩)
        (fun b hb => by obtain ⟨n, hn⟩ := hb.exists; exact hn.trans measureReal_le_one)

private theorem band_mean_mem_unit (n : ℕ) (μ : FiniteMixture)
    (Q m M b β L R : ℝ) :
    (∫ J, originalBandComplementMass μ Q m M b β (Icc L R) J
      ∂disorderLaw (n+2) μ.maxDegree) ∈ Icc (0 : ℝ) 1 := by
  refine ⟨integral_nonneg fun _ => measureReal_nonneg, ?_⟩
  apply (integral_mono
    (originalBandComplementMass_integrable (N := n+2) (by omega) μ Q m M b β isClosed_Icc)
    (integrable_const (1 : ℝ)) (fun J =>
      (originalBandComplementMass_mem_unit (N := n+2) (by omega) μ Q m M b β (Icc L R) J).2)).trans_eq
  simp

private theorem count_capture_center_shift
    (μ : FiniteMixture) {β x Q L R b₀ : ℝ} {ma m : ℕ → ℝ}
    (p : CountCapturePackage μ β x Q L R b₀ ma)
    {B : ℝ} (hB : 0 < B) (hdiff : ∀ n, |m n-ma n| ≤ B)
    (hm : Tendsto (fun n => m n / ((n+2 : ℕ) : ℝ)) atTop (𝓝 (markE μ β x Q)))
    (hlog : ∃ A : ℝ, 0 < A ∧ ∀ᶠ n : ℕ in atTop,
      |m n-((n+2 : ℕ)*markE μ β x Q-Real.log (n+2 : ℕ)/(2*(β*x)))| ≤ A) :
    CountCapturePackage μ β x Q L R b₀ m := by
  have hsub : Tendsto (fun M : ℝ => M-B) atTop atTop :=
    tendsto_atTop_add_const_right atTop (-B) tendsto_id
  refine ⟨hm, hlog, ?_, ?_, ?_⟩
  · intro M hM
    obtain ⟨A, hA, hbound⟩ := p.uniform_count (M+B) (by linarith)
    refine ⟨A, hA, fun n => le_trans ?_ (hbound n)⟩
    apply lintegral_mono
    intro J
    apply score_window_count_mono
    intro z hz
    rcases hz with ⟨hz, hr⟩
    refine ⟨⟨?_, ?_⟩, hr⟩ <;> have hd := abs_le.mp (hdiff n) <;>
      dsimp only [Set.mem_preimage, Set.mem_Icc] at hz ⊢ <;> linarith [hz.1, hz.2]
  · apply (p.joint_ground.comp hsub).squeeze' tendsto_const_nhds
    · exact .of_forall fun M => Filter.liminf_le_liminf
        (.of_forall fun n => measureReal_mono (fun J hJ => by
          rcases hJ with ⟨⟨u, hu, hc, he, hr⟩, hmax⟩
          have hd := abs_le.mp (hdiff (n+1))
          refine ⟨⟨u, hu, hc, ⟨?_, ?_⟩, hr⟩, ?_⟩ <;> linarith [he.1, he.2])
          (measure_ne_top _ _))
        (isBoundedUnder_of ⟨0, fun _ => measureReal_nonneg⟩)
        (isBoundedUnder_of ⟨(1 : ℝ), fun _ => measureReal_le_one⟩).isCoboundedUnder_ge
    · exact .of_forall fun M => liminf_le_of_le
        (isBoundedUnder_of ⟨0, fun _ => measureReal_nonneg⟩)
        (fun b hb => by obtain ⟨n, hn⟩ := hb.exists; exact hn.trans measureReal_le_one)
  · intro b hb hbb
    apply squeeze_zero' (g := fun M : ℝ => limsup (fun n => ∫ J,
      originalBandComplementMass μ Q (ma n) (M-B) b β (Icc L R) J
        ∂disorderLaw (n+2) μ.maxDegree) atTop)
    · exact .of_forall fun M => le_limsup_of_le
        (isBoundedUnder_of ⟨1, fun n => (band_mean_mem_unit n μ Q (m n) M b β L R).2⟩)
        (fun z hz => by
          obtain ⟨n, hn⟩ := hz.exists
          exact (band_mean_mem_unit n μ Q (m n) M b β L R).1.trans hn)
    · exact .of_forall fun M => limsup_le_limsup
        (.of_forall fun n => integral_mono
          (originalBandComplementMass_integrable (N := n+2) (by omega) μ Q (m n) M b β isClosed_Icc)
          (originalBandComplementMass_integrable (N := n+2) (by omega) μ Q (ma n) (M-B) b β isClosed_Icc)
          (fun J => by
            let := mixtureGibbsLaw_probability (by omega : 1 ≤ n+2) μ β J
            unfold originalBandComplementMass
            apply measureReal_mono (compl_subset_compl.mpr ?_) (measure_ne_top _ _)
            rintro σ ⟨⟨u, hu, hband⟩, hσ⟩
            rcases hu with ⟨⟨⟨hu, hc⟩, he⟩, hr⟩
            have hd := abs_le.mp (hdiff n)
            refine ⟨⟨u, ⟨⟨⟨hu, hc⟩, ⟨?_, ?_⟩⟩, hr⟩, hband⟩, hσ⟩ <;>
              linarith [he.1, he.2]))
        (isCoboundedUnder_le_of_le atTop fun n => (band_mean_mem_unit n μ Q (m n) M b β L R).1)
        (isBoundedUnder_of ⟨1, fun n => (band_mean_mem_unit n μ Q (ma n) (M-B) b β L R).2⟩)
    · exact (p.capture b hb hbb).comp hsub

private theorem pure_retained_radial_identification
    (p : ℕ) (hp : 2 ≤ p) (a : ℝ) (ha : 0 < a)
    {β x Q L R δ : ℝ} (h : Certificate (FiniteMixture.pure p hp a ha) β x Q)
    (hL : L < markK (FiniteMixture.pure p hp a ha) β Q)
    (hR : markK (FiniteMixture.pure p hp a ha) β Q < R) (hδ : 0 < δ)
    (m : ℕ → ℝ)
    (hm : Tendsto (fun n => m n / ((n+2 : ℕ) : ℝ)) atTop
      (𝓝 (markE (FiniteMixture.pure p hp a ha) β x Q)))
    (t κ C ε η G : ℝ) :
    let μ := FiniteMixture.pure p hp a ha
    let E := markE μ β x Q
    ∀ᶠ n : ℕ in atTop, ∀ J : Disorder (n+3) μ.maxDegree,
      sourceRetainedScoreWindowCount (n+2) (centerCoefficients (mixtureCoefficients μ) Q)
        (physicalEnergyWindow (n+3) (Icc (m (n+1)-t) (m (n+1)+t)) (Icc L R))
        κ C ε η E G J =
      sourceRetainedValueWindowCount (n+2) (centerCoefficients (mixtureCoefficients μ) Q)
        (sourcePureCenteredNormalizedWindow n m E δ (-t) t) κ C ε η E G J := by
  let μ := FiniteMixture.pure p hp a ha
  let E := markE μ β x Q
  have hp0 : (0 : ℝ) < p := by exact_mod_cast (by omega : 0 < p)
  have hdim : Tendsto (fun n : ℕ => ((n+3 : ℕ) : ℝ)) atTop atTop :=
    tendsto_natCast_atTop_atTop.comp (tendsto_add_atTop_nat 3)
  have hd : Tendsto (fun n : ℕ => t / ((n+3 : ℕ) : ℝ)) atTop (𝓝 0) :=
    hdim.const_div_atTop t
  have hm' : Tendsto (fun n : ℕ => m (n+1) / ((n+3 : ℕ) : ℝ)) atTop (𝓝 E) :=
    hm.comp (tendsto_add_atTop_nat 1)
  have hlo : Tendsto (fun n : ℕ => (m (n+1)-t)/((n+3 : ℕ) : ℝ)) atTop (𝓝 E) := by
    simpa only [sub_div, sub_zero] using hm'.sub hd
  have hhi : Tendsto (fun n : ℕ => (m (n+1)+t)/((n+3 : ℕ) : ℝ)) atTop (𝓝 E) := by
    simpa only [add_div, add_zero] using hm'.add hd
  have hK : markK μ β Q = (p : ℝ)*E :=
    source_pure_markK_eq_degree_mul_markE p hp a ha h
  filter_upwards [hlo.eventually (eventually_gt_nhds (show E-δ < E by linarith)),
    hhi.eventually (eventually_lt_nhds (show E < E+δ by linarith)),
    (hlo.const_mul (p : ℝ)).eventually (eventually_gt_nhds (show L < (p : ℝ)*E by rwa [← hK])),
    (hhi.const_mul (p : ℝ)).eventually (eventually_lt_nhds (show (p : ℝ)*E < R by rwa [← hK]))]
    with n hlow hhigh hradlow hradhigh
  intro J
  unfold sourceRetainedScoreWindowCount sourceRetainedValueWindowCount
  rw [actual_pure_scoreWindowCount_eq_valueWindowCount (n+2) p hp a ha Q]
  congr 1
  ext e
  simp only [pureScoreWindow, pureScoreLine, Set.mem_preimage]
  change (((n+3 : ℕ) : ℝ)*e ∈ Icc (m (n+1)-t) (m (n+1)+t) ∧ (p : ℝ)*e ∈ Icc L R) ↔
    (((n+3 : ℕ) : ℝ)*e ∈ Icc (m (n+1)+ -t) (m (n+1)+t) ∧
      ((n+3 : ℕ) : ℝ)*e ∈ Ioo (((n+3 : ℕ) : ℝ)*(E-δ)) (((n+3 : ℕ) : ℝ)*(E+δ)))
  have hN : (0 : ℝ) < (n+3 : ℕ) := by positivity
  have haux (he : ((n+3 : ℕ) : ℝ)*e ∈ Icc (m (n+1)-t) (m (n+1)+t)) :
      (p : ℝ)*e ∈ Icc L R ∧
      ((n+3 : ℕ) : ℝ)*e ∈ Ioo (((n+3 : ℕ) : ℝ)*(E-δ)) (((n+3 : ℕ) : ℝ)*(E+δ)) := by
    have hel : (m (n+1)-t)/((n+3 : ℕ) : ℝ) ≤ e :=
      (div_le_iff₀ hN).mpr (by simpa only [mul_comm] using he.1)
    have her : e ≤ (m (n+1)+t)/((n+3 : ℕ) : ℝ) :=
      (le_div_iff₀ hN).mpr (by simpa only [mul_comm] using he.2)
    exact ⟨⟨(hradlow.trans_le (mul_le_mul_of_nonneg_left hel hp0.le)).le,
      ((mul_le_mul_of_nonneg_left her hp0.le).trans_lt hradhigh).le⟩,
      ⟨mul_lt_mul_of_pos_left (hlow.trans_le hel) hN,
        mul_lt_mul_of_pos_left (her.trans_lt hhigh) hN⟩⟩
  constructor
  · intro he
    exact ⟨by simpa only [sub_eq_add_neg] using he.1, (haux he.1).2⟩
  · intro he
    have he' : ((n+3 : ℕ) : ℝ)*e ∈ Icc (m (n+1)-t) (m (n+1)+t) := by
      simpa only [sub_eq_add_neg] using he.1
    exact ⟨he', (haux he').1⟩

/-- The scalar pure selected count is eventually exactly the selected
physical energy/radial count on the common closed interval. -/
def PureWindowIdentification (μ : FiniteMixture) (β x Q C η ε δ L R : ℝ)
    (m : ℕ → ℝ) (t : ℝ) : Prop :=
  let E := markE μ β x Q
  let g := (markK μ β Q-2*Real.sqrt (Q^2*μ.xi2 Q))/2
  let G := gap μ Q (markY β Q) (markZ x Q) ε η
  ∀ᶠ n : ℕ in atTop, ∀ J : Disorder (n+3) μ.maxDegree,
    sourceRetainedScoreWindowCount (n+2) (centerCoefficients (mixtureCoefficients μ) Q)
      (physicalEnergyWindow (n+3) (Icc (m (n+1)-t) (m (n+1)+t)) (Icc L R))
      (g/2) C ε η E G J =
    sourceRetainedValueWindowCount (n+2) (centerCoefficients (mixtureCoefficients μ) Q)
      (sourcePureCenteredNormalizedWindow n m E δ (-t) t) (g/2) C ε η E G J

/-- The pure selected count at a normalized local-maximum tail center,
with exactly the source zero, half-mean, and centered-maximum estimates. -/
def PureSharpAtWindow (μ : FiniteMixture) (β x Q C cut η ε δ : ℝ)
    (m : ℕ → ℝ) (t : ℝ) : Prop :=
  let E := markE μ β x Q
  let g := (markK μ β Q-2*Real.sqrt (Q^2*μ.xi2 Q))/2
  let G := gap μ Q (markY β Q) (markZ x Q) ε η
  let I n := sourcePureCenteredNormalizedWindow n m E δ (-t) t
  let aN n := sourceRetainedValueWindowMean (n+2) μ Q (I n) (g/2) C ε η E G
  let X n J := (sourceRetainedValueWindowCount (n+2)
    (centerCoefficients (mixtureCoefficients μ) Q) (I n) (g/2) C ε η E G J).toReal
  let A := Real.exp ((β*x)*t)-Real.exp (-(β*x)*t)
  let k := 1+(1-ε)/(cut^2-ε)
  Filter.limsup (fun n => (disorderLaw (n+3) μ.maxDegree).real
    {J | X n J = 0}) atTop ≤ k/A ∧
  Filter.limsup (fun n => (disorderLaw (n+3) μ.maxDegree).real
    {J | X n J < aN n/2}) atTop ≤ 4*k/A ∧
  Filter.limsup (fun n => (disorderLaw (n+3) μ.maxDegree).real
    {J | |sourceSphereMaximum (n+1) μ Q J-m (n+1)| > t}) atTop ≤
      Real.exp (-(β*x)*t)+k/A

private theorem pure_value_joint_probability_of_limsup
    (μ : FiniteMixture) (Q : ℝ) (m : ℕ → ℝ)
    (X : (n : ℕ) → Disorder (n+3) μ.maxDegree → ℝ)
    (L a b : ℝ)
    (hzero : Filter.limsup (fun n : ℕ =>
      (disorderLaw (n+3) μ.maxDegree).real {J | X n J=0}) atTop ≤ a)
    (hupper : Filter.limsup (fun n : ℕ =>
      (disorderLaw (n+3) μ.maxDegree).real
        {J | m (n+1)+L ≤ sourceSphereMaximum (n+1) μ Q J}) atTop ≤ b)
    (hbelow : ∀ n : ℕ, ∀ J : Disorder (n+3) μ.maxDegree,
      sourceSphereMaximum (n+1) μ Q J < m (n+1)-L → X n J=0) :
    Filter.limsup (fun n : ℕ =>
      (disorderLaw (n+3) μ.maxDegree).real
        {J | |sourceSphereMaximum (n+1) μ Q J-m (n+1)| > L}) atTop ≤ b+a ∧
    1-(b+a) ≤ Filter.liminf (fun n : ℕ =>
      (disorderLaw (n+3) μ.maxDegree).real
        {J | X n J ≠ 0 ∧ sourceSphereMaximum (n+1) μ Q J < m (n+1)+L}) atTop := by
  let pzero (n : ℕ) := (disorderLaw (n+3) μ.maxDegree).real {J | X n J=0}
  let pupper (n : ℕ) := (disorderLaw (n+3) μ.maxDegree).real
    {J | m (n+1)+L ≤ sourceSphereMaximum (n+1) μ Q J}
  let pdev (n : ℕ) := (disorderLaw (n+3) μ.maxDegree).real
    {J | |sourceSphereMaximum (n+1) μ Q J-m (n+1)| > L}
  let pgood (n : ℕ) := (disorderLaw (n+3) μ.maxDegree).real
    {J | X n J ≠ 0 ∧ sourceSphereMaximum (n+1) μ Q J < m (n+1)+L}
  have hpointDev : ∀ n, pdev n ≤ pupper n+pzero n := by
    intro n
    have hsubset : {J : Disorder (n+3) μ.maxDegree |
        |sourceSphereMaximum (n+1) μ Q J-m (n+1)| > L} ⊆
      {J | m (n+1)+L ≤ sourceSphereMaximum (n+1) μ Q J} ∪
      {J | X n J=0} := by
      intro J hJ
      change L < |sourceSphereMaximum (n+1) μ Q J-m (n+1)| at hJ
      change m (n+1)+L ≤ sourceSphereMaximum (n+1) μ Q J ∨ X n J=0
      rcases (lt_abs.mp hJ) with hhigh | hlow
      · exact Or.inl (by linarith)
      · exact Or.inr (hbelow n J (by linarith))
    exact (measureReal_mono hsubset (measure_ne_top _ _)).trans
      (measureReal_union_le _ _)
  have huB : IsBoundedUnder (· ≤ ·) atTop pupper :=
    isBoundedUnder_of ⟨1,fun n => measureReal_le_one⟩
  have huL : IsBoundedUnder (· ≥ ·) atTop pupper :=
    isBoundedUnder_of ⟨0,fun n => measureReal_nonneg⟩
  have hzB : IsBoundedUnder (· ≤ ·) atTop pzero :=
    isBoundedUnder_of ⟨1,fun n => measureReal_le_one⟩
  have hzL : IsCoboundedUnder (· ≤ ·) atTop pzero :=
    isCoboundedUnder_le_of_le atTop (fun n => measureReal_nonneg)
  have hSumB : IsBoundedUnder (· ≤ ·) atTop (fun n => pupper n+pzero n) :=
    isBoundedUnder_of ⟨2,fun n => by
      have h1 : pupper n ≤ 1 := measureReal_le_one
      have h2 : pzero n ≤ 1 := measureReal_le_one
      linarith⟩
  have hSumL : IsCoboundedUnder (· ≤ ·) atTop (fun n => pupper n+pzero n) :=
    isCoboundedUnder_le_of_le atTop (fun n => add_nonneg measureReal_nonneg measureReal_nonneg)
  have hSum : Filter.limsup (fun n => pupper n+pzero n) atTop ≤ b+a :=
    (limsup_add_le huL huB hzL hzB).trans (add_le_add hupper hzero)
  have hDev : Filter.limsup pdev atTop ≤ b+a := by
    have hLo : IsCoboundedUnder (· ≤ ·) atTop pdev :=
      isCoboundedUnder_le_of_le atTop (fun n => measureReal_nonneg)
    exact (limsup_le_limsup (Eventually.of_forall hpointDev) hLo hSumB).trans hSum
  have hpointGood : ∀ n, 1-(pupper n+pzero n) ≤ pgood n := by
    intro n
    let good : Set (Disorder (n+3) μ.maxDegree) :=
      {J | X n J ≠ 0 ∧ sourceSphereMaximum (n+1) μ Q J < m (n+1)+L}
    let bad : Set (Disorder (n+3) μ.maxDegree) :=
      {J | m (n+1)+L ≤ sourceSphereMaximum (n+1) μ Q J} ∪
      {J | X n J=0}
    have huniv : good ∪ bad = Set.univ := by
      ext J
      simp only [good,bad,Set.mem_union,Set.mem_ofPred_eq,Set.mem_univ,iff_true]
      by_cases hX : X n J=0
      · exact Or.inr (Or.inr hX)
      · by_cases hM : sourceSphereMaximum (n+1) μ Q J < m (n+1)+L
        · exact Or.inl ⟨hX,hM⟩
        · exact Or.inr (Or.inl (le_of_not_gt hM))
    have hone : (1 : ℝ) ≤ pgood n+(pupper n+pzero n) := by
      calc
        (1 : ℝ) = (disorderLaw (n+3) μ.maxDegree).real Set.univ := by simp
        _ = (disorderLaw (n+3) μ.maxDegree).real (good ∪ bad) := by rw [huniv]
        _ ≤ (disorderLaw (n+3) μ.maxDegree).real good+
          (disorderLaw (n+3) μ.maxDegree).real bad := measureReal_union_le _ _
        _ ≤ pgood n+(pupper n+pzero n) := by
          exact add_le_add_right (measureReal_union_le _ _) _
    linarith
  have hLow : IsBoundedUnder (· ≥ ·) atTop
      (fun n => 1-(pupper n+pzero n)) :=
    isBoundedUnder_of ⟨-1,fun n => by
      have h1 : pupper n ≤ 1 := measureReal_le_one
      have h2 : pzero n ≤ 1 := measureReal_le_one
      linarith⟩
  have hGoodB : IsCoboundedUnder (· ≥ ·) atTop pgood :=
    (isBoundedUnder_of ⟨(1 : ℝ),fun n => measureReal_le_one⟩ :
      IsBoundedUnder (· ≤ ·) atTop pgood).isCoboundedUnder_ge
  have hinf := Filter.liminf_le_liminf (Eventually.of_forall hpointGood)
    hLow hGoodB
  have hEq := liminf_const_sub atTop (fun n => pupper n+pzero n) (1 : ℝ)
    hSumB hSumL
  rw [hEq] at hinf
  exact ⟨hDev,(sub_le_sub_left hSum 1).trans hinf⟩

/-- The pure branch of the complete package, with arbitrary positive
amplitude, the same normalized center for sharp counts and capture, and
all sufficiently small widths chosen before either limit. -/
theorem pure_normalized_count_capture_package_of_literature
    (p : ℕ) (hp : 2 ≤ p) (a : ℝ) (ha : 0 < a)
    {β x Q : ℝ} (h : Certificate (FiniteMixture.pure p hp a ha) β x Q)
    (hChen : Chen2013FiniteParisi) (hChenSen : ChenSenFiniteGround)
    (h5 : Theorem5 (literatureThermodynamicData hChen hChenSen
      (FiniteMixture.pure p hp a ha) h.beta_pos.le))
    (h25 : Remark25Contrapositive (FiniteMixture.pure p hp a ha) β)
    (h24 : Proposition24 (FiniteMixture.pure p hp a ha) β Q) :
    let μ := FiniteMixture.pure p hp a ha
    ∃ L R b₀ C cut η ε δ : ℝ, ∃ m : ℕ → ℝ,
      sourceRadialEdge μ Q < L ∧ L < markK μ β Q ∧ markK μ β Q < R ∧
      0 < b₀ ∧ b₀ < Real.sqrt Q ∧ 0 < δ ∧
      0 < cut ∧ cut ≤ 1 ∧ 0 < ε ∧ ε < cut^2/2 ∧ ε < 1-η ∧
      CountCapturePackage μ β x Q L R b₀ m ∧
      (∀ᶠ n : ℕ in atTop, ExpectedTailCentering.tail
        (pureTruncatedLocalMaxDensity n p hp a ha Q
          ((n+2 : ℕ)*(markE μ β x Q-δ)) ((n+2 : ℕ)*(markE μ β x Q+δ))) (m n) = 1) ∧
      ∀ t : ℝ, 0 < t → PureSharpAtWindow μ β x Q C cut η ε δ m t ∧
        PureWindowIdentification μ β x Q C η ε δ L R m t := by
  let μ := FiniteMixture.pure p hp a ha
  obtain ⟨L, R, b₀, hEdge, hL, hR, hb₀, hb₀Q, pp⟩ :=
    pure_count_capture_package_of_literature μ h
      (by simp only [μ, pure_minDegree, pure_maxDegree, lt_self_iff_false, not_false_eq_true])
      hChen hChenSen h5 h25 h24
  obtain ⟨m, M, C, cut, η, ε, δ, D, hM, hδ, _hLeft, _hpδ,
    hcenter, hUnit, hcut, hcutOne, hε, hεCut, hεη, _hD,
    _hUnfiltered, _hMean, _hMoments, hInputs⟩ :=
    source_pure_actual_retained_same_center_probability_with_unit p hp a ha h
  have hd : ∀ᶠ n : ℕ in atTop,
      |m n-sourcePureAnalyticCenter (n+2) (markE μ β x Q) (β*x)| ≤ M := hcenter
  obtain ⟨B, hB⟩ := (show IsBoundedUnder (· ≤ ·) atTop
      (fun n => |m n-sourcePureAnalyticCenter (n+2) (markE μ β x Q) (β*x)|) from
        ⟨M, hd⟩).bddAbove_range
  have hB' : 0 < max B 1 := lt_of_lt_of_le zero_lt_one (le_max_right _ _)
  have hd' : ∀ n, |m n-sourcePureAnalyticCenter (n+2) (markE μ β x Q) (β*x)| ≤ max B 1 :=
    fun n => (hB (mem_range_self n)).trans (le_max_left _ _)
  have hc0 := mul_pos h.beta_pos h.weight_range.1
  have hlog := NatLogWindowScales.normalized_center_log_bounded hc0 hM.le m hcenter
  have hr := NatLogWindowScales.log_bounded_sequence_div_dimension_tendsto_zero
    (show 0 ≤ 1/(2*(β*x))+1 by positivity)
    (fun n => m n-(n+2 : ℕ)*markE μ β x Q) hlog
  have hm : Tendsto (fun n => m n / ((n+2 : ℕ) : ℝ)) atTop
      (𝓝 (markE μ β x Q)) := by
    convert hr.add_const (markE μ β x Q) using 1
    · funext n
      have hn : ((n+2 : ℕ) : ℝ) ≠ 0 := by positivity
      field_simp
      ring
    · simp
  refine ⟨L, R, b₀, C, cut, η, ε, δ, m, hEdge, hL, hR, hb₀, hb₀Q, hδ,
    hcut, hcutOne, hε, hεCut, hεη, count_capture_center_shift μ pp hB' hd' hm ⟨M, hM, hcenter⟩,
    hUnit.mono (fun _ hn => hn.1), ?_⟩
  intro t ht
  refine ⟨⟨(hInputs t ht).1, (hInputs t ht).2.1, ?_⟩,
    pure_retained_radial_identification p hp a ha h hL hR hδ m hm t _ C ε η _⟩
  let E := markE μ β x Q
  let g := (markK μ β Q-2*Real.sqrt (Q^2*μ.xi2 Q))/2
  let G := gap μ Q (markY β Q) (markZ x Q) ε η
  let X n J := (sourceRetainedValueWindowCount (n+2)
    (centerCoefficients (mixtureCoefficients μ) Q)
    (sourcePureCenteredNormalizedWindow n m E δ (-t) t) (g/2) C ε η E G J).toReal
  exact (pure_value_joint_probability_of_limsup μ Q m X t _ _
    (hInputs t ht).1 (hInputs t ht).2.2.1 (hInputs t ht).2.2.2).1

/-- The complete common-witness count/existence/capture conclusions for
all certified finite mixtures, either parity and every positive pure
amplitude. Mixed centers retain their normalized-tail first-moment record;
pure centers retain their normalized truncated local-maximum tail. -/
theorem finiteMixture_count_capture_package_of_literature
    (μ : FiniteMixture) {β x Q : ℝ} (h : Certificate μ β x Q)
    (hChen : Chen2013FiniteParisi) (hChenSen : ChenSenFiniteGround)
    (h5 : Theorem5 (literatureThermodynamicData hChen hChenSen μ h.beta_pos.le))
    (h25 : Remark25Contrapositive μ β) (h24 : Proposition24 μ β Q) :
    ∃ L R b₀ : ℝ, sourceRadialEdge μ Q < L ∧ L < markK μ β Q ∧
      markK μ β Q < R ∧ 0 < b₀ ∧ b₀ < Real.sqrt Q ∧
      ∃ m : ℕ → ℝ, CountCapturePackage μ β x Q L R b₀ m := by
  by_cases hnp : μ.minDegree < μ.maxDegree
  · obtain ⟨C, cut, η, ε, L, R, b₀, _hC, _hcut, _hcutOne, _hcutRad, _hη,
      _hηCollar, _hε, _hεCut, _hεη, hEdge, hL, hR, hb₀, hb₀Q, d, hpkg, _⟩ :=
      mixed_count_capture_package_of_literature μ h hnp hChen hChenSen h5 h25 h24
    exact ⟨L, R, b₀, hEdge, hL, hR, hb₀, hb₀Q, d.center, hpkg⟩
  · obtain ⟨p, hp, a, ha, hμ⟩ :=
      SourceConditionedCPTransfer.pure_representation_of_not_nonpure μ hnp
    subst μ
    obtain ⟨L, R, b₀, C, cut, η, ε, δ, m, hEdge, hL, hR, hb₀, hb₀Q, _hδ,
      _hcut, _hcutOne, _hε, _hεCut, _hεη, hpkg, _⟩ :=
      pure_normalized_count_capture_package_of_literature p hp a ha h
        hChen hChenSen h5 h25 h24
    exact ⟨L, R, b₀, hEdge, hL, hR, hb₀, hb₀Q, m, hpkg⟩



namespace LiteralInitial

private instance literalSphere_compactSpace (N : ℕ) :
    CompactSpace ({x : Vector N | OnSphere x} : Set (Vector N)) :=
  isCompact_iff_compactSpace.mp (physicalSphere_compact N)

private abbrev LiteralField (μ : FiniteMixture) (N : ℕ) :=
  Space (mixtureCoefficients μ) {x : Vector N | OnSphere x}

private def literalFieldMap (μ : FiniteMixture) (N : ℕ) :
    Disorder N μ.maxDegree →L[ℝ] LiteralField μ N :=
  project (mixtureCoefficients μ) {x : Vector N | OnSphere x}

private def literalFieldLift (μ : FiniteMixture) (N : ℕ) :
    LiteralField μ N →L[ℝ] Disorder N μ.maxDegree :=
  lift (mixtureCoefficients μ) {x : Vector N | OnSphere x}

/-- Evaluation measurability of the literal spherical function retains
exactly the Borel information in its continuous finite-dimensional image. -/
private theorem literalFieldMap_indep {N : ℕ} {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) (μ : FiniteMixture) (J : Ω → Disorder N μ.maxDegree)
    (ν : Ω → ProbabilityMeasure (Vector N))
    (hind : IndepFun
      (fun ω => fun x : {x : Vector N // OnSphere x} =>
        field (mixtureCoefficients μ) (J ω) x) ν P) :
    IndepFun (fun ω => literalFieldMap μ N (J ω)) ν P := by
  have hspace : (Subtype.instMeasurableSpace : MeasurableSpace (LiteralField μ N)) =
      MeasurableSpace.comap
        (fun H : LiteralField μ N => fun x : {x : Vector N // OnSphere x} => H.val x)
        (MeasurableSpace.pi : MeasurableSpace ({x : Vector N // OnSphere x} → ℝ)) := by
    let : CompactSpace {x : Vector N // OnSphere x} :=
      isCompact_iff_compactSpace.mp (physicalSphere_compact N)
    change MeasurableSpace.comap Subtype.val
      (inferInstance : MeasurableSpace C({x : Vector N // OnSphere x}, ℝ)) = _
    rw [ContinuousMap.measurableSpace_eq_iSup_comap_eval]
    simp only [MeasurableSpace.pi, MeasurableSpace.comap_iSup,
      MeasurableSpace.comap_comp]
    rfl
  rw [IndepFun_iff_Indep] at hind ⊢
  rw [hspace, MeasurableSpace.comap_comp]
  exact hind

private def literalFieldDistance {N : ℕ} (μ : FiniteMixture) (β : ℝ) (T : ℝ≥0)
    (H : LiteralField μ N) (ν : ProbabilityMeasure (Vector N)) : ℝ :=
  SphericalOrthogonalHaar.distance μ β T (literalFieldLift μ N H) ν

private theorem literalFieldDistance_measurable {N : ℕ} (hN : 1 ≤ N)
    (μ : FiniteMixture) (β : ℝ) (T : ℝ≥0) :
    Measurable (fun p : LiteralField μ N × ProbabilityMeasure (Vector N) =>
      literalFieldDistance μ β T p.1 p.2) := by
  exact (distance_joint_measurable hN μ β T).comp
    (((literalFieldLift μ N).measurable.comp measurable_fst).prodMk measurable_snd)

private theorem literalFieldDistance_factorization {N : ℕ} (hN : 1 ≤ N)
    (μ : FiniteMixture) (β : ℝ) (T : ℝ≥0) (J : Disorder N μ.maxDegree)
    (ν : ProbabilityMeasure (Vector N)) (hν : ∀ᵐ x ∂ν.toMeasure, OnSphere x) :
    SphericalOrthogonalHaar.distance μ β T J ν =
      literalFieldDistance μ β T (literalFieldMap μ N J) ν := by
  have hf : ∀ x : Vector N, OnSphere x →
      fieldOfMixture μ J x =
        fieldOfMixture μ (literalFieldLift μ N (literalFieldMap μ N J)) x := by
    intro x hx
    exact (field_lift (mixtureCoefficients μ) {y : Vector N | OnSphere y}
      (literalFieldMap μ N J) ⟨x, hx⟩).symm
  have hκ : mixedTransitionKernel μ J β T ∘ₘ ν.toMeasure =
      mixedTransitionKernel μ (literalFieldLift μ N (literalFieldMap μ N J)) β T
        ∘ₘ ν.toMeasure := by
    apply Measure.comp_congr
    filter_upwards [hν] with x hx
    exact mixedTransitionKernel_congr_onSphere hN μ J _ β hf T x hx
  have hπ : mixtureGibbsLaw μ β J =
      mixtureGibbsLaw μ β (literalFieldLift μ N (literalFieldMap μ N J)) :=
    gibbsLaw_congr_onSphere hN β hf
  unfold SphericalOrthogonalHaar.distance literalFieldDistance
  rw [hκ, hπ]
  unfold SphericalOrthogonalHaar.distance
  rfl

/-- The original Haar failure bound needs independence only from the
spherical Hamiltonian, even when the remaining tensor information depends
on the random initial probability. -/
private theorem independent_literal_initial_failure_le {N : ℕ} {Ω : Type*}
    [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P] (hN : 1 ≤ N)
    (μ : FiniteMixture) (β : ℝ) (T : ℝ≥0)
    (J : Ω → Disorder N μ.maxDegree) (ν : Ω → ProbabilityMeasure (Vector N))
    (hJ : HasLaw J (disorderLaw N μ.maxDegree) P) (hν : AEMeasurable ν P)
    (hind : IndepFun
      (fun ω => fun x : {x : Vector N // OnSphere x} =>
        field (mixtureCoefficients μ) (J ω) x) ν P)
    (hsphere : ∀ᵐ ω ∂P, ∀ᵐ x ∂(ν ω).toMeasure, OnSphere x)
    {ε : ℝ} (hε : 0 < ε) :
    P.real {ω | SphericalOrthogonalHaar.intervalDistance μ β T (J ω) (ν ω) < 1-ε} ≤
      ε⁻¹ * (∫ D, 1-SphericalOrthogonalHaar.distance μ β T D (uniformInitialProbability N)
        ∂disorderLaw N μ.maxDegree) := by
  let η : Measure (ProbabilityMeasure (Vector N)) := P.map ν
  have : IsProbabilityMeasure η := (Measure.isProbabilityMeasure_map_iff hν).mpr inferInstance
  have hη : ∀ᵐ ξ ∂η, ∀ᵐ x ∂ξ.toMeasure, OnSphere x :=
    (ae_map_iff hν (sphericalInitialProbability_measurableSet N)).mpr hsphere
  let d : Measure (LiteralField μ N) :=
    (disorderLaw N μ.maxDegree).map (literalFieldMap μ N)
  have hmap : HasLaw (literalFieldMap μ N) d (disorderLaw N μ.maxDegree) :=
    hasLaw_map (literalFieldMap μ N).measurable.aemeasurable
  have hH := hmap.fun_comp hJ
  have hpair : HasLaw (fun ω => (literalFieldMap μ N (J ω), ν ω)) (d.prod η) P := by
    refine ⟨hH.aemeasurable.prodMk hν, ?_⟩
    rw [(literalFieldMap_indep P μ J ν hind).map_prod_eq_prod_map_map
      hH.aemeasurable hν, hH.map_eq]
  have hraw : HasLaw
      (fun p : Disorder N μ.maxDegree × ProbabilityMeasure (Vector N) =>
        (literalFieldMap μ N p.1, p.2))
      (d.prod η) ((disorderLaw N μ.maxDegree).prod η) := by
    refine ⟨((literalFieldMap μ N).measurable.prodMap measurable_id).aemeasurable, ?_⟩
    simpa only [Measure.map_id, Prod.map_def, id_eq, d] using
      (Measure.map_prod_map (disorderLaw N μ.maxDegree) η
        (literalFieldMap μ N).measurable measurable_id).symm
  have hE : MeasurableSet
      {p : LiteralField μ N × ProbabilityMeasure (Vector N) |
        literalFieldDistance μ β T p.1 p.2 < 1-ε} :=
    measurableSet_lt (literalFieldDistance_measurable hN μ β T) measurable_const
  have he : {ω | SphericalOrthogonalHaar.intervalDistance μ β T (J ω) (ν ω) < 1-ε} =ᵐ[P]
      {ω | literalFieldDistance μ β T (literalFieldMap μ N (J ω)) (ν ω) < 1-ε} := by
    filter_upwards [hsphere] with ω hω
    simp only [SphericalOrthogonalHaar.intervalDistance_eq_endpoint hN μ β T,
      literalFieldDistance_factorization hN μ β T (J ω) (ν ω) hω]
  have hsraw : ∀ᵐ p ∂(disorderLaw N μ.maxDegree).prod η,
      ∀ᵐ x ∂p.2.toMeasure, OnSphere x :=
    Measure.quasiMeasurePreserving_snd.ae hη
  have heraw :
      {p : Disorder N μ.maxDegree × ProbabilityMeasure (Vector N) |
        SphericalOrthogonalHaar.intervalDistance μ β T p.1 p.2 < 1-ε} =ᵐ[(disorderLaw N μ.maxDegree).prod η]
      {p | literalFieldDistance μ β T (literalFieldMap μ N p.1) p.2 < 1-ε} := by
    filter_upwards [hsraw] with p hp
    simp only [SphericalOrthogonalHaar.intervalDistance_eq_endpoint hN μ β T,
      literalFieldDistance_factorization hN μ β T p.1 p.2 hp]
  rw [measureReal_congr he, hpair.measureReal_eq hE,
    ← hraw.measureReal_eq hE, ← measureReal_congr heraw]
  exact independent_random_initial_failure_le hN μ β T η hη hε


end LiteralInitial

private theorem random_sphere_menu_measurable {N : ℕ} {ι R : Type*}
    [Fintype ι] [Nonempty ι] [MeasurableSpace R]
    (hN : 1 ≤ N) (μ : FiniteMixture) (β : ℝ) (T : ℝ≥0)
    (ν : R → ι → Measure (Vector N)) (hν : ∀ j, Measurable (fun r => ν r j))
    [∀ r j, IsProbabilityMeasure (ν r j)] :
    Measurable (fun z : R × SphereField N μ => sphereMenuDistance μ β (ν z.1) T z.2) := by
  let κ := ReductionFiniteMenu.randomInitial (Ω := Field N μ) ν hν
  let K := ReductionFiniteMenu.liftTransition R (transitionKernel (N := N) μ β T)
  let π : Kernel (R × Field N μ) (Vector N) :=
    (gibbsKernel (N := N) μ β).comap Prod.snd measurable_snd
  have he : (fun z : R × Field N μ =>
      SphericalMenuReduction.physicalMenuDistance μ β (ν z.1) T z.2) =
      fun z => ReductionFiniteMenu.menuDistance
        (fun j => ReductionJointInformation.evolvedKernel (κ j) K z) (π z) := by
    funext z
    rw [SphericalMenuReduction.physicalMenuDistance_eq_endpoint hN]
    congr 1
    funext j
    rw [ReductionJointInformation.evolvedKernel_apply,
      ReductionJointInformation.evolvedKernel_apply,
      ReductionFiniteMenu.liftTransition_conditional]
    rfl
  have hm : Measurable (fun z : R × Field N μ =>
      SphericalMenuReduction.physicalMenuDistance μ β (ν z.1) T z.2) := by
    rw [he]
    exact ReductionFiniteMenu.menu_endpoint_measurable κ K π
  change Measurable ((fun z : R × Field N μ =>
    SphericalMenuReduction.physicalMenuDistance μ β (ν z.1) T z.2) ∘
      (fun z : R × SphereField N μ => (z.1, sphereRepresentative (N := N) μ z.2)))
  exact hm.comp (measurable_fst.prodMk
    ((sphereRepresentative (N := N) μ).measurable.comp measurable_snd))

/-- All source initial-law clauses at a specified exponent. Sphere-supported
kernels are probability kernels to the manuscript's state space `S_N`,
represented here as ambient-vector kernels with their literal support. -/
def SphericalInitialConclusions (μ : FiniteMixture) (β γ : ℝ) : Prop :=
  let T := fun N => exponentialGridHorizon γ N
  VaryingConvergesInProbability (fun n => disorderLaw (n+2) μ.maxDegree)
    (fun n => originalUniformIntervalDistance μ β (T (n+2))) (fun _ _ => 1) ∧
  uniformSeparationInProbability μ β T ∧
  (∀ ε : ℝ, 0 < ε → Tendsto (uniformPrescribedFailure μ β T ε) atTop (𝓝 0)) ∧
  (∀ (Ω : ℕ → Type) [∀ N, MeasurableSpace (Ω N)]
      (P : ∀ N, Measure (Ω N)) [∀ N, IsProbabilityMeasure (P N)]
      (J : ∀ N, Ω N → Disorder N μ.maxDegree)
      (ν : ∀ N, Ω N → ProbabilityMeasure (Vector N)),
      (∀ N, HasLaw (J N) (disorderLaw N μ.maxDegree) (P N)) →
      (∀ N, AEMeasurable (ν N) (P N)) →
      (∀ N, IndepFun (fun ω => fun y : {y : Vector N // OnSphere y} =>
        field (mixtureCoefficients μ) (J N ω) y) (ν N) (P N)) →
      (∀ N, 1 ≤ N → ∀ᵐ ω ∂P N, ∀ᵐ y ∂(ν N ω).toMeasure, OnSphere y) →
      ∀ ε : ℝ, 0 < ε → Tendsto (fun N => (P N).real
        {ω | SphericalOrthogonalHaar.intervalDistance μ β (T N) (J N ω) (ν N ω) < 1-ε})
        atTop (𝓝 0)) ∧
  (∀ (ι : ℕ → Type u) [∀ N, Fintype (ι N)] [∀ N, Nonempty (ι N)]
      (ν : ∀ N, ι N → Measure (Vector N)) [∀ N j, IsProbabilityMeasure (ν N j)],
      (∀ N, 2 ≤ N → ∀ j, ∀ᵐ y ∂ν N j, OnSphere y) →
      ∀ κ C₀ : ℝ, 0 ≤ κ → κ < ((μ.minDegree : ℝ)-2)/2 → 0 < C₀ →
      (∀ᶠ N in atTop, (Fintype.card (ι N) : ℝ) ≤ C₀*(N : ℝ)^κ) →
      VaryingProbability.InProbability (fun N => sphereFieldLaw N μ)
        (fun N => sphereMenuDistance μ β (ν N) (T N)) 1) ∧
  (∀ (ι : ℕ → Type u) [∀ N, Fintype (ι N)] [∀ N, Nonempty (ι N)]
      (R : ℕ → Type v) [∀ N, MeasurableSpace (R N)]
      (ρ : ∀ N, Measure (R N)) [∀ N, IsProbabilityMeasure (ρ N)]
      (ν : ∀ N, R N → ι N → Measure (Vector N)),
      (∀ N j, Measurable (fun r => ν N r j)) →
      ∀ [∀ N r j, IsProbabilityMeasure (ν N r j)],
      (∀ N, 2 ≤ N → ∀ r j, ∀ᵐ y ∂ν N r j, OnSphere y) →
      ∀ κ C₀ : ℝ, 0 ≤ κ → κ < ((μ.minDegree : ℝ)-2)/2 → 0 < C₀ →
      (∀ᶠ N in atTop, (Fintype.card (ι N) : ℝ) ≤ C₀*(N : ℝ)^κ) →
      VaryingProbability.InProbability (fun N => (ρ N).prod (sphereFieldLaw N μ))
        (fun N z => sphereMenuDistance μ β (ν N z.1) (T N) z.2) 1) ∧
  (∀ (κ : ∀ N, Kernel (SphereField N μ) (Vector N)) [∀ N, IsMarkovKernel (κ N)],
      (∀ N, 2 ≤ N → ∀ H, ∀ᵐ y ∂κ N H, OnSphere y) →
      ReductionEntropy.LittleLogInProbability (fun N => sphereFieldLaw N μ)
        (fun N H => InformationTheory.klDiv (κ N H) (sphereLaw N)) →
      VaryingProbability.InProbability (fun N => sphereFieldLaw N μ)
        (fun N => sphereIntervalDistance μ β (T N) (κ N)) 1) ∧
  (∀ (κ : ∀ N, Kernel (SphereField N μ) (Vector N)) [∀ N, IsMarkovKernel (κ N)],
      (∀ N, 2 ≤ N → ∀ H, ∀ᵐ y ∂κ N H, OnSphere y) →
      ReductionInformation.LittleLog (fun N =>
        endpointMutualInformation (sphereFieldLaw N μ) (κ N)) →
      VaryingProbability.InProbability (fun N => sphereFieldLaw N μ)
        (fun N => sphereIntervalDistance μ β (T N) (κ N)) 1)

/-- Manuscript `thm:main-initial`(i)--(iii) and `cor:cp-information` for
all certified finite mixtures, with one positive exponent and independence
and information measured only against the actual spherical Hamiltonian. -/
theorem finiteMixture_all_initial_spherical_of_literature
    (μ : FiniteMixture) {β x Q : ℝ} (h : Certificate μ β x Q)
    (hChen : Chen2013FiniteParisi) (hChenSen : ChenSenFiniteGround)
    (h5 : Theorem5 (literatureThermodynamicData hChen hChenSen μ h.beta_pos.le))
    (h25 : Remark25Contrapositive μ β) (h24 : Proposition24 μ β Q) :
    ∃ γ : ℝ, 0 < γ ∧ SphericalInitialConclusions.{u,v} μ β γ := by
