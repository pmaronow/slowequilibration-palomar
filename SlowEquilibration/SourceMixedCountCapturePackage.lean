attribute [local irreducible] mixedTransitionKernel

universe u v

/-- The actual finite-dimensional image of the Hamiltonian on the sphere.
Its Borel sigma-algebra is generated by point evaluations. -/
abbrev SphereField (N : ℕ) (μ : FiniteMixture) :=
  SphereSpace (N := N) (mixtureCoefficients μ)

/-- The law of the spherical Hamiltonian, with ambient polynomial and
redundant tensor coordinates removed. -/
abbrev sphereFieldLaw (N : ℕ) (μ : FiniteMixture) : Measure (SphereField N μ) :=
  law (mixtureCoefficients μ) (fieldSphere N)

/-- The spherical image carries exactly the sigma-algebra generated by
the values of the Hamiltonian on the sphere. -/
theorem sphereField_measurableSpace_eq_evaluations (N : ℕ) (μ : FiniteMixture) :
    (inferInstance : MeasurableSpace (SphereField N μ)) =
      MeasurableSpace.comap
        (fun H : SphereField N μ => fun y : fieldSphere N => H.val y)
        (MeasurableSpace.pi : MeasurableSpace (fieldSphere N → ℝ)) := by
  change MeasurableSpace.comap Subtype.val
    (inferInstance : MeasurableSpace C(fieldSphere N, ℝ)) = _
  rw [ContinuousMap.measurableSpace_eq_iSup_comap_eval]
  simp only [MeasurableSpace.pi, MeasurableSpace.comap_iSup, MeasurableSpace.comap_comp]
  rfl

/-- A continuous coefficient section for the spherical image. -/
def sphereLift {N : ℕ} (μ : FiniteMixture) :
    SphereField N μ →L[ℝ] Disorder N μ.maxDegree :=
  lift (mixtureCoefficients μ) (fieldSphere N)

/-- Restrict the ambient polynomial image to the physical sphere. -/
def sphereRestriction {N : ℕ} (μ : FiniteMixture) :
    Field N μ →L[ℝ] SphereField N μ :=
  (project (mixtureCoefficients μ) (fieldSphere N)).comp (coefficientLift μ)

/-- A full polynomial representative of a spherical Hamiltonian. -/
def sphereRepresentative {N : ℕ} (μ : FiniteMixture) :
    SphereField N μ →L[ℝ] Field N μ := (fieldMap μ).comp (sphereLift (N := N) μ)

private theorem sphereRestriction_fieldMap {N : ℕ} (μ : FiniteMixture)
    (J : Disorder N μ.maxDegree) :
    sphereRestriction (N := N) μ (fieldMap (N := N) μ J) = project (mixtureCoefficients μ) (fieldSphere N) J := by
  change project (mixtureCoefficients μ) (fieldSphere N)
      (coefficientLift (N := N) μ (fieldMap (N := N) μ J)) =
    project (mixtureCoefficients μ) (fieldSphere N) J
  exact Subtype.ext (ContinuousMap.ext fun y : fieldSphere N =>
    full_lift_project_on_sphere (N := N) (P := μ.maxDegree)
      (mixtureCoefficients μ) J y.val
      ((mem_fieldSphere_iff (N := N) y.val).mp y.property))

private theorem sphereRestriction_law {N : ℕ} (μ : FiniteMixture) :
    (fieldLaw N μ).map (sphereRestriction (N := N) μ) = sphereFieldLaw N μ := by
  change ((disorderLaw N μ.maxDegree).map (fieldMap (N := N) μ)).map (sphereRestriction (N := N) μ) = _
  rw [Measure.map_map (g := sphereRestriction (N := N) μ) (f := fieldMap (N := N) μ)
    (sphereRestriction (N := N) μ).measurable (fieldMap (N := N) μ).measurable]
  congr 1
  funext J
  exact sphereRestriction_fieldMap (N := N) μ J

private theorem sphereRestriction_hasLaw {N : ℕ} (μ : FiniteMixture) :
    HasLaw (sphereRestriction (N := N) μ) (sphereFieldLaw N μ) (fieldLaw N μ) :=
  ⟨(sphereRestriction (N := N) μ).measurable.aemeasurable, sphereRestriction_law μ⟩

private theorem sphereRestriction_representative {N : ℕ} (μ : FiniteMixture)
    (H : SphereField N μ) : sphereRestriction (N := N) μ (sphereRepresentative (N := N) μ H) = H := by
  change sphereRestriction (N := N) μ (fieldMap (N := N) μ (sphereLift (N := N) μ H)) = H
  rw [sphereRestriction_fieldMap]
  exact project_lift _ _ H

private theorem sphere_field_eq {N : ℕ} (μ : FiniteMixture) (H : Field N μ)
    (y : Vector N) (hy : OnSphere y) :
    fieldOfMixture μ (coefficientLift (N := N) μ H) y =
      fieldOfMixture μ (coefficientLift (N := N) μ (sphereRepresentative (N := N) μ (sphereRestriction (N := N) μ H))) y := by
  have hyn : ‖y‖^2 = (N : ℝ) := (onSphere_iff_norm_sq y).mp hy
  rw [show fieldOfMixture μ (coefficientLift (N := N) μ (sphereRepresentative (N := N) μ (sphereRestriction (N := N) μ H))) y =
      fieldOfMixture μ (sphereLift (N := N) μ (sphereRestriction (N := N) μ H)) y from
        congrFun (lifted_field_eq μ (sphereLift (N := N) μ (sphereRestriction (N := N) μ H))) y]
  exact (sphere_lift_project_on_sphere (mixtureCoefficients μ)
    (coefficientLift (N := N) μ H) y hyn).symm

/-- The full real-time interval infimum for a kernel depending only on
the spherical Hamiltonian. The representative is a constructed linear lift. -/
def sphereIntervalDistance {N : ℕ} (μ : FiniteMixture) (β : ℝ) (T : ℝ≥0)
    (κ : Kernel (SphereField N μ) (Vector N)) (H : SphereField N μ) : ℝ :=
  SphericalFieldKernels.intervalDistance μ β T
    (κ.comap (sphereRestriction (N := N) μ) (sphereRestriction (N := N) μ).measurable)
    (sphereRepresentative (N := N) μ H)

/-- The literal infimum over convex menu weights and all times, as a
function of the spherical Hamiltonian alone. -/
def sphereMenuDistance {N : ℕ} {ι : Type*} [Fintype ι] [Nonempty ι]
    (μ : FiniteMixture) (β : ℝ) (ν : ι → Measure (Vector N))
    (T : ℝ≥0) (H : SphereField N μ) : ℝ :=
  SphericalMenuReduction.physicalMenuDistance μ β ν T (sphereRepresentative (N := N) μ H)

private theorem interval_sphere_factor {N : ℕ} (hN : 1 ≤ N)
    (μ : FiniteMixture) (β : ℝ) (T : ℝ≥0)
    (κ : Kernel (SphereField N μ) (Vector N)) [IsMarkovKernel κ]
    (hs : ∀ H, ∀ᵐ y ∂κ H, OnSphere y) (H : Field N μ) :
    SphericalFieldKernels.intervalDistance μ β T
      (κ.comap (sphereRestriction (N := N) μ) (sphereRestriction (N := N) μ).measurable) H =
      sphereIntervalDistance μ β T κ (sphereRestriction (N := N) μ H) := by
  let κa := κ.comap (sphereRestriction (N := N) μ) (sphereRestriction (N := N) μ).measurable
  have he : κa (sphereRepresentative (N := N) μ (sphereRestriction (N := N) μ H)) = κa H := by
    simp only [κa, Kernel.comap_apply, sphereRestriction_representative]
  rw [sphereIntervalDistance,
    SphericalFieldKernels.intervalDistance_eq_endpoint hN,
    SphericalFieldKernels.intervalDistance_eq_endpoint hN]
  unfold SphericalFieldKernels.endpointDistance
  rw [evolvedKernel_apply_physical, evolvedKernel_apply_physical, he,
    gibbsKernel_apply, gibbsKernel_apply]
  congr 1
  · apply Measure.comp_congr
    filter_upwards [hs (sphereRestriction (N := N) μ H)] with y hy
    exact mixedTransitionKernel_congr_onSphere hN μ _ _ β (sphere_field_eq μ H) T y hy
  · exact gibbsLaw_congr_onSphere hN β (sphere_field_eq μ H)

private theorem menu_sphere_factor {N : ℕ} {ι : Type*} [Fintype ι] [Nonempty ι]
    (hN : 1 ≤ N) (μ : FiniteMixture) (β : ℝ)
    (ν : ι → Measure (Vector N)) [∀ j, IsProbabilityMeasure (ν j)]
    (hs : ∀ j, ∀ᵐ y ∂ν j, OnSphere y) (T : ℝ≥0) (H : Field N μ) :
    SphericalMenuReduction.physicalMenuDistance μ β ν T H =
      sphereMenuDistance μ β ν T (sphereRestriction (N := N) μ H) := by
  rw [sphereMenuDistance, SphericalMenuReduction.physicalMenuDistance_eq_endpoint hN,
    SphericalMenuReduction.physicalMenuDistance_eq_endpoint hN]
  have hπ : gibbsKernel μ β H = gibbsKernel μ β
      (sphereRepresentative (N := N) μ (sphereRestriction (N := N) μ H)) := by
    rw [gibbsKernel_apply, gibbsKernel_apply]
    exact gibbsLaw_congr_onSphere hN β (sphere_field_eq μ H)
  rw [hπ]
  congr 1
  funext j
  rw [evolvedKernel_apply_physical, evolvedKernel_apply_physical]
  apply Measure.comp_congr
  filter_upwards [hs j] with y hy
  exact mixedTransitionKernel_congr_onSphere hN μ _ _ β (sphere_field_eq μ H) T y hy

private theorem sphereIntervalDistance_measurable {N : ℕ} (hN : 1 ≤ N)
    (μ : FiniteMixture) (β : ℝ) (T : ℝ≥0)
    (κ : Kernel (SphereField N μ) (Vector N)) [IsMarkovKernel κ] :
    Measurable (sphereIntervalDistance μ β T κ) :=
  (SphericalFieldKernels.intervalDistance_measurable hN μ β T _).comp
    (sphereRepresentative (N := N) μ).measurable

private theorem sphereMenuDistance_measurable {N : ℕ} {ι : Type*}
    [Fintype ι] [Nonempty ι] (hN : 1 ≤ N) (μ : FiniteMixture) (β : ℝ)
    (ν : ι → Measure (Vector N)) [∀ j, IsProbabilityMeasure (ν j)] (T : ℝ≥0) :
    Measurable (sphereMenuDistance μ β ν T) :=
  (SphericalMenuReduction.physicalMenuDistance_measurable hN μ β ν T).comp
    (sphereRepresentative (N := N) μ).measurable

private theorem inProbability_sphere_transport
    (μ : FiniteMixture) (f : ∀ N, SphereField N μ → ℝ)
    (hf : ∀ N, 1 ≤ N → Measurable (f N))
    (h : VaryingProbability.InProbability (fun N => fieldLaw N μ)
      (fun N H => f N (sphereRestriction (N := N) μ H)) 1) :
    VaryingProbability.InProbability (fun N => sphereFieldLaw N μ) f 1 := by
  intro ε hε
  apply (h ε hε).congr'
  filter_upwards [eventually_ge_atTop 1] with N hN
  exact (sphereRestriction_hasLaw (N := N) μ).measureReal_eq
    (show MeasurableSet {H : SphereField N μ | ε ≤ ‖f N H-1‖} from
      measurableSet_le measurable_const (((hf N hN).sub measurable_const).norm))

private theorem sphere_information_identity {N : ℕ} (μ : FiniteMixture)
    (κ : Kernel (SphereField N μ) (Vector N)) [IsMarkovKernel κ] :
    endpointMutualInformation (fieldLaw N μ)
      (κ.comap (sphereRestriction (N := N) μ) (sphereRestriction (N := N) μ).measurable) =
      endpointMutualInformation (sphereFieldLaw N μ) κ := by
  rw [InformationFactorization.mutualInformation_of_measurable_factor,
    sphereRestriction_law]


