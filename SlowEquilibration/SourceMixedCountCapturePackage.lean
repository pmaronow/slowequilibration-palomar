/-- The common logarithmic correction bounds the difference of centers,
even when their radial intervals and finite prefixes differ. -/
private theorem source_centers_eventually_bounded_difference
    {μ : FiniteMixture} {β x Q L₁ R₁ L₂ R₂ : ℝ}
    (d₁ : SourceMaximumFirstMomentConclusions μ β x Q L₁ R₁)
    (d₂ : SourceMaximumFirstMomentConclusions μ β x Q L₂ R₂) :
    ∀ᶠ n : ℕ in atTop,
      |d₁.center n - d₂.center n| ≤ d₁.log_constant + d₂.log_constant := by
  filter_upwards [d₁.logarithmic_correction, d₂.logarithmic_correction] with n h₁ h₂
  have h₂' : |((n+2 : ℕ)*markE μ β x Q-
      Real.log (n+2 : ℕ)/(2*(β*x))) - d₂.center n| ≤ d₂.log_constant := by
    rwa [abs_sub_comm]
  exact (abs_sub_le (d₁.center n)
    ((n+2 : ℕ)*markE μ β x Q-Real.log (n+2 : ℕ)/(2*(β*x))) (d₂.center n)).trans
      (add_le_add h₁ h₂')

/-- The closed consumer interval is chosen strictly inside the analytic
open interval; its boundary points are therefore covered as well. -/
private theorem closed_radial_window_subset_open {L₀ L R R₀ : ℝ}
    (hL : L₀ < L) (hR : R < R₀) : Icc L R ⊆ Ioo L₀ R₀ := by
  intro k hk
  exact ⟨hL.trans_le hk.1, hk.2.trans_lt hR⟩

/-- The two fixed radial boundary points contribute zero to the expected
ordinary count, by the physical Kac--Rice density. -/
private theorem originalWindowExpectedCount_closed_eq_open
    (μ : FiniteMixture) {Q : ℝ} (hQ : 0 < Q)
    (hnp : μ.minDegree < μ.maxDegree) (m : ℕ → ℝ) (M L R : ℝ) (n : ℕ) :
    originalWindowExpectedCount μ Q m M (Icc L R) n =
      originalWindowExpectedCount μ Q m M (Ioo L R) n := by
  unfold originalWindowExpectedCount
  rw [actual_mixed_critical_physical_intensity n μ hQ hnp _ _
    measurableSet_Icc measurableSet_Icc,
    actual_mixed_critical_physical_intensity n μ hQ hnp _ _
      measurableSet_Icc measurableSet_Ioo]
  simp only [restrict_Ioo_eq_restrict_Icc]


private theorem score_window_count_mono {P : ℕ} (n : ℕ) (c : Degree P → ℝ)
    (K₁ K₂ : Set (EuclideanSpace ℝ (Fin 2))) (hK : K₁ ⊆ K₂)
    (ψ : Disorder (n+1) P → Vector (n+1) → ℝ≥0∞) (J : Disorder (n+1) P) :
    actualScoreWindowCount n c K₁ ψ J ≤ actualScoreWindowCount n c K₂ ψ J := by
  classical
  rw [actualScoreWindowCount_eq_indicator, actualScoreWindowCount_eq_indicator]
  unfold SphericalKacRiceGluing.actualSphereCount
  apply ENNReal.tsum_le_tsum
  intro u
  dsimp only
  by_cases h₁ : actualScore c J u ∈ K₁
  · simp only [h₁, hK h₁, ↓reduceIte, le_refl]
  · by_cases h₂ : actualScore c J u ∈ K₂ <;>
      simp only [h₁, h₂, ↓reduceIte, zero_le, le_refl]


private theorem physical_window_count_mono_radial (n : ℕ) (μ : FiniteMixture) (Q : ℝ)
    (I U V : Set ℝ) (hUV : U ⊆ V)
    (ψ : Disorder (n+2) μ.maxDegree → Vector (n+2) → ℝ≥0∞)
    (J : Disorder (n+2) μ.maxDegree) :
    actualScoreWindowCount (n+1) (centerCoefficients (mixtureCoefficients μ) Q)
      (physicalEnergyWindow (n+2) I U) ψ J ≤
    actualScoreWindowCount (n+1) (centerCoefficients (mixtureCoefficients μ) Q)
      (physicalEnergyWindow (n+2) I V) ψ J :=
  score_window_count_mono (n+1) (centerCoefficients (mixtureCoefficients μ) Q)
    (physicalEnergyWindow (n+2) I U) (physicalEnergyWindow (n+2) I V)
    (fun _ hz => ⟨hz.1,hUV hz.2⟩) ψ J

/-- One choice of all inputs to the mixed fixed-window reduction. The
scale has a positive finite prefix and equals the exact source band scale
eventually. The low-sum estimate is uniform in the window width. -/
private structure CommonWitness (μ : FiniteMixture) (β x Q E L R b₀ : ℝ)
    (m : ℕ → ℝ) (τ : ℝ) (D : ℕ → ℝ) where
  overlap_range : Q ∈ Ioo (0 : ℝ) 1
  scale_pos : ∀ n, 0 < D n
  scale_eventually_eq : ∀ᶠ n : ℕ in atTop,
    D n = sourceCriticalBandScale (n+1) μ overlap_range β (m n)
  first_moments : ∃ L₀ R₀ : ℝ, ∃ d : SourceMaximumFirstMomentConclusions μ β x Q L₀ R₀,
    m = d.center
  normalized_center : Tendsto (fun n => m n / ((n+2 : ℕ) : ℝ)) atTop (𝓝 E)
  uniform_count : ∀ M : ℝ, 0 < M → ∃ B : ℝ, 0 < B ∧
    ∀ n : ℕ, originalWindowExpectedCount μ Q m M (Icc L R) n ≤ ENNReal.ofReal B
  count : ∀ M : ℝ, 0 < M →
    limsup (originalWindowExpectedCount μ Q m M (Icc L R)) atTop < ⊤
  upper : Tendsto (fun M : ℝ => limsup (fun n : ℕ =>
    (disorderLaw (n+2) μ.maxDegree).real
      {J | m n+M < sourceSphereMaximum n μ Q J}) atTop) atTop (𝓝 0)
  coarse : ∀ b : ℝ, 0 < b → Tendsto (fun n =>
    ∫ J, originalCoarseBandComplementMass n μ Q E τ b β (Icc L R) J
      ∂disorderLaw (n+2) μ.maxDegree) atTop (𝓝 0)
  C : ℝ
  a : ℝ
  C_pos : 0 < C
  a_pos : 0 < a
  low_sum : ∀ᶠ n : ℕ in atTop, ∀ b : ℝ, 0 < b → b ≤ b₀ →
    ∀ M : ℝ, 0 ≤ M →
      (∫⁻ J, originalLowBandPartitionSum n μ Q E τ (m n) M b β (Icc L R) J
        ∂disorderLaw (n+2) μ.maxDegree) ≤
        ENNReal.ofReal (C * D n * Real.exp (-a*M))
  denominator : Tendsto (fun s : ℝ => limsup (fun n : ℕ =>
    (disorderLaw (n+2) μ.maxDegree).real
      {J | mixturePartition μ β J < s*D n}) atTop) (𝓝[>] 0) (𝓝 0)

private theorem source_center_normalized
    {μ : FiniteMixture} {β x Q L R : ℝ} (h : Certificate μ β x Q)
    (d : SourceMaximumFirstMomentConclusions μ β x Q L R) :
    Tendsto (fun n => d.center n / ((n+2 : ℕ) : ℝ)) atTop
      (𝓝 (markE μ β x Q)) := by
  have hc := mul_pos h.beta_pos h.weight_range.1
  have hlog := NatLogWindowScales.normalized_center_log_bounded hc
    d.log_constant_pos.le d.center d.logarithmic_correction
  have hr := NatLogWindowScales.log_bounded_sequence_div_dimension_tendsto_zero
    (show 0 ≤ 1/(2*(β*x))+1 by positivity)
    (fun n => d.center n-(n+2 : ℕ)*markE μ β x Q) hlog
  convert hr.add_const (markE μ β x Q) using 1
  · funext n
    have hn : ((n+2 : ℕ) : ℝ) ≠ 0 := by positivity
    field_simp
    ring
  · simp

private theorem source_center_upper_tight
    {μ : FiniteMixture} {β x Q L R : ℝ} (h : Certificate μ β x Q)
    (hnp : μ.minDegree < μ.maxDegree) (hEdge : sourceRadialEdge μ Q < L)
    (hL : L < markK μ β Q) (hR : markK μ β Q < R)
    (d : SourceMaximumFirstMomentConclusions μ β x Q L R) :
    Tendsto (fun M : ℝ => limsup (fun n : ℕ =>
      (disorderLaw (n+2) μ.maxDegree).real
        {J | d.center n+M < sourceSphereMaximum n μ Q J}) atTop) atTop (𝓝 0) := by
  have hc := mul_pos h.beta_pos h.weight_range.1
  have hκ := sourceMarkedLeastCurvature_pos μ h.overlap_range.1
    (by have hd := h.min_degree; omega) hnp
  have hu := sourceRadialClearance_pos μ (show markK μ β Q ∈ Ioo L R from ⟨hL,hR⟩)
  let δ := sourceMarkedLeastCurvature μ Q *
    (sourceRadialClearance μ β Q (Ioo L R))^2/(8*(β*x))
  have hδ : 0 < δ := by dsimp [δ]; positivity
  have hexp : Tendsto (fun M : ℝ => Real.exp (-(β*x)*M)) atTop (𝓝 0) :=
    Real.tendsto_exp_atBot.comp (tendsto_id.const_mul_atTop_of_neg (neg_neg_of_pos hc))
  apply squeeze_zero (fun M => ?_) (fun M => ?_) hexp
  · have hh := limsup_le_limsup
      (.of_forall fun n : ℕ => (measureReal_nonneg :
        0 ≤ (disorderLaw (n+2) μ.maxDegree).real
          {J | d.center n+M < sourceSphereMaximum n μ Q J}))
      (isCoboundedUnder_le_of_le atTop fun _ : ℕ => le_rfl (a := (0 : ℝ)))
      (isBoundedUnder_of ⟨1,fun _ => measureReal_le_one⟩)
    simpa only [limsup_const] using hh
  · apply le_trans ?_ (sourceSphereMaximum_centered_probability_limsup
      μ h hnp hEdge ⟨hL,hR⟩ hδ (le_refl δ) d M)
    apply limsup_le_limsup (.of_forall fun n => ?_)
      (isCoboundedUnder_le_of_le atTop fun _ => measureReal_nonneg)
      (isBoundedUnder_of ⟨1,fun _ => measureReal_le_one⟩)
    exact measureReal_mono (fun _ hJ => (show d.center n+M < _ from hJ).le)
      (measure_ne_top _ _)

private theorem band_scale_shift (n : ℕ) (μ : FiniteMixture)
    {Q : ℝ} (hQ : Q ∈ Ioo (0 : ℝ) 1) (β m t : ℝ) :
    sourceCriticalBandScale n μ hQ β (m+t) =
      Real.exp (β*t) * sourceCriticalBandScale n μ hQ β m := by
  unfold sourceCriticalBandScale
  rw [mul_add, Real.exp_add]
  ring

private theorem denominator_transfer
    {μ : FiniteMixture} {β x Q L₁ R₁ L₂ R₂ : ℝ}
    (h : Certificate μ β x Q)
    (d₁ : SourceMaximumFirstMomentConclusions μ β x Q L₁ R₁)
    (d₂ : SourceMaximumFirstMomentConclusions μ β x Q L₂ R₂)
    (D : ℕ → ℝ)
    (hD : ∀ᶠ n : ℕ in atTop,
      D n = sourceCriticalBandScale (n+1) μ h.overlap_range β (d₁.center n))
    (hheavy : ∀ ρ : ℝ, 0 < ρ → ∃ T δ : ℝ, 0 < T ∧ 0 < δ ∧
      limsup (fun n : ℕ => (disorderLaw (n+3) μ.maxDegree).real
        {J | partition (n+3) β (field (mixtureCoefficients μ) J) <
          δ*Real.exp (-β*T)*sourceCriticalBandScale (n+2) μ h.overlap_range β
            (d₂.center (n+1))}) atTop ≤ 2*ρ) :
    Tendsto (fun s : ℝ => limsup (fun n : ℕ =>
      (disorderLaw (n+2) μ.maxDegree).real
        {J | mixturePartition μ β J < s*D n}) atTop) (𝓝[>] 0) (𝓝 0) := by
  let B := d₁.log_constant + d₂.log_constant
  have hscale : ∀ᶠ n : ℕ in atTop,
      Real.exp (-β*B)*D n ≤
        sourceCriticalBandScale (n+1) μ h.overlap_range β (d₂.center n) := by
    filter_upwards [hD, source_centers_eventually_bounded_difference d₁ d₂,
      eventually_ge_atTop 1] with n hn hcent hn1
    rw [hn]
    have hd : -B ≤ d₂.center n-d₁.center n := by
      have hh := (abs_le.mp hcent).2
      dsimp [B]
      linarith
    have he : Real.exp (-β*B) ≤ Real.exp (β*(d₂.center n-d₁.center n)) := by
      apply Real.exp_le_exp.mpr
      nlinarith [h.beta_pos]
    have hshift := band_scale_shift (n+1) μ h.overlap_range β (d₁.center n)
      (d₂.center n-d₁.center n)
    rw [add_sub_cancel] at hshift
    rw [hshift]
    exact mul_le_mul_of_nonneg_right he
      (sourceCriticalBandScale_pos (n+1) (by omega) μ h.overlap_range β _).le
  apply tendsto_order.mpr
  constructor
  · intro z hz
    refine .of_forall fun s => hz.trans_le ?_
    have hh := limsup_le_limsup
      (.of_forall fun n : ℕ => (measureReal_nonneg :
        0 ≤ (disorderLaw (n+2) μ.maxDegree).real
          {J | mixturePartition μ β J < s*D n}))
      (isCoboundedUnder_le_of_le atTop fun _ : ℕ => le_rfl (a := (0 : ℝ)))
      (isBoundedUnder_of ⟨1,fun _ => measureReal_le_one⟩)
    simpa only [limsup_const] using hh
  · intro ε hε
    obtain ⟨T,δ,_hT,hδ,hprob⟩ := hheavy (ε/4) (by positivity)
    let s₀ := δ*Real.exp (-β*T)*Real.exp (-β*B)
    have hs₀ : 0 < s₀ := by dsimp [s₀]; positivity
    have hprob' : limsup (fun n : ℕ => (disorderLaw (n+2) μ.maxDegree).real
        {J | mixturePartition μ β J < δ*Real.exp (-β*T)*
          sourceCriticalBandScale (n+1) μ h.overlap_range β (d₂.center n)}) atTop ≤
        2*(ε/4) := by
      let f := fun n : ℕ => (disorderLaw (n+2) μ.maxDegree).real
        {J | mixturePartition μ β J < δ*Real.exp (-β*T)*
          sourceCriticalBandScale (n+1) μ h.overlap_range β (d₂.center n)}
      have heq : limsup (fun n => f (n+1)) atTop = limsup f atTop := by
        rw [← Function.comp_def, limsup_comp, map_add_atTop_eq_nat]
      rw [← heq]
      exact hprob
    filter_upwards [self_mem_nhdsWithin,
      nhdsWithin_le_nhds (gt_mem_nhds hs₀)] with s hs hss
    apply lt_of_le_of_lt (b := 2*(ε/4)) ?_ (by linarith)
    apply le_trans ?_ hprob'
    apply limsup_le_limsup ?_
      (isCoboundedUnder_le_of_le atTop fun _ => measureReal_nonneg)
      (isBoundedUnder_of ⟨1,fun _ => measureReal_le_one⟩)
    filter_upwards [hscale, hD, eventually_ge_atTop 1] with n hn hnD hn1
    apply measureReal_mono ?_ (measure_ne_top _ _)
    intro J hJ
    have hDn : 0 ≤ D n := by
      rw [hnD]
      exact (sourceCriticalBandScale_pos (n+1) (by omega) μ h.overlap_range β _).le
    have hh := mul_le_mul_of_nonneg_left hn
      (show 0 ≤ δ*Real.exp (-β*T) by positivity)
    have hsD := mul_le_mul_of_nonneg_right hss.le hDn
    change mixturePartition μ β J < _ at hJ ⊢
    dsimp [s₀] at hsD
    nlinarith

private theorem common_witness_of_estimates
    (μ : FiniteMixture) {β x Q : ℝ}
    (h : Certificate μ β x Q) (hnp : μ.minDegree < μ.maxDegree)
    (hChen : Chen2013FiniteParisi) (hChenSen : ChenSenFiniteGround)
    (h5 : Theorem5 (literatureThermodynamicData hChen hChenSen μ h.beta_pos.le))
    (h25 : Remark25Contrapositive μ β) (h24 : Proposition24 μ β Q)
    {L₀ R₀ bLow C τ a Lh Rh : ℝ}
    (hEdge : sourceRadialEdge μ Q < L₀)
    (hLK : L₀ < markK μ β Q) (hKR : markK μ β Q < R₀)
    (hbLow : 0 < bLow) (hC : 0 < C) (hτ : 0 < τ) (ha : 0 < a)
    (d : SourceMaximumFirstMomentConclusions μ β x Q L₀ R₀)
    (hLow : ∀ᶠ n : ℕ in atTop, ∀ b : ℝ, 0 < b → b ≤ bLow →
      ∀ M : ℝ, 0 ≤ M →
        (∫⁻ J, actualScoreWindowCount (n+1)
          (centerCoefficients (mixtureCoefficients μ) Q)
          (physicalEnergyWindow (n+2)
            (Ico (((n+2 : ℕ) : ℝ)*(markE μ β x Q-τ)) (d.center n-M)) (Ioo L₀ R₀))
          (sourceMixedBandMark n μ β (Real.sqrt Q) b) J
          ∂disorderLaw (n+2) μ.maxDegree) ≤
          ENNReal.ofReal (C*sourceCriticalBandScale (n+1) μ h.overlap_range β
            (d.center n)*Real.exp (-a*M)))
    (dh : SourceMaximumFirstMomentConclusions μ β x Q Lh Rh)
    (hHeavy : ∀ ρ : ℝ, 0 < ρ → ∃ T δ : ℝ, 0 < T ∧ 0 < δ ∧
      limsup (fun n : ℕ => (disorderLaw (n+3) μ.maxDegree).real
        {J | partition (n+3) β (field (mixtureCoefficients μ) J) <
          δ*Real.exp (-β*T)*sourceCriticalBandScale (n+2) μ h.overlap_range β
            (dh.center (n+1))}) atTop ≤ 2*ρ) :
    ∃ L R b₀ : ℝ,
      2 * Real.sqrt (Q^2 * μ.xi2 Q) < L ∧
      L < markK μ β Q ∧ markK μ β Q < R ∧
      0 < b₀ ∧ b₀ < Real.sqrt Q ∧
      ∃ (m : ℕ → ℝ) (τ : ℝ) (D : ℕ → ℝ), 0 < τ ∧
        Nonempty (CommonWitness μ β x Q (markE μ β x Q) L R b₀ m τ D) := by
  let L := (L₀+markK μ β Q)/2
  let R := (markK μ β Q+R₀)/2
  have hL₀ : L₀ < L := by dsimp [L]; linarith
  have hL : L < markK μ β Q := by dsimp [L]; linarith
  have hR : markK μ β Q < R := by dsimp [R]; linarith
  have hR₀ : R < R₀ := by dsimp [R]; linarith
  have hInside := closed_radial_window_subset_open hL₀ hR₀
  have hEdge' : 2 * Real.sqrt (Q^2*μ.xi2 Q) < L := by
    exact (show 2 * Real.sqrt (Q^2*μ.xi2 Q) < L₀ from hEdge).trans hL₀
  let b₀ := min bLow (Real.sqrt Q/2)
  have hsqrt : 0 < Real.sqrt Q := Real.sqrt_pos.mpr h.overlap_range.1
  have hb₀ : 0 < b₀ := lt_min hbLow (by positivity)
  have hb₀Q : b₀ < Real.sqrt Q :=
    (min_le_right _ _).trans_lt (by linarith)
  let D := fun n : ℕ => if n = 0 then 1 else
    sourceCriticalBandScale (n+1) μ h.overlap_range β (d.center n)
  have hD : ∀ n, 0 < D n := by
    intro n
    dsimp [D]
    split_ifs with hn
    · norm_num
    · exact sourceCriticalBandScale_pos (n+1) (by omega) μ h.overlap_range β _
  have hDeq : ∀ᶠ n : ℕ in atTop,
      D n = sourceCriticalBandScale (n+1) μ h.overlap_range β (d.center n) := by
    filter_upwards [eventually_ge_atTop 1] with n hn
    exact ite_eq_right (by omega)
  have hNorm := SourceLiteraturePhysicalNormQ.physicalDirectingNormQ_of_cited_theorems
    hChen hChenSen h h5 h25
  have hMean := mixed_contactReplicaMeanEnergy_of_literature μ h hChen h24
  have hRel : CenterFieldRelocation μ Q (markE μ β x Q) (Icc L R) := by
    intro r hr
    obtain ⟨ε₀,hε₀,Ω,hΩ,hmove,hprob⟩ :=
      mixed_centerFieldRelocation μ h hnp hEdge' hL hR r hr
    refine ⟨ε₀,hε₀,Ω,hΩ,?_,hprob⟩
    intro n J hJ w hw he
    obtain ⟨u,hu,hcrit,hk,hdist,henergy⟩ := hmove n J hJ w hw he
    exact ⟨u,hu,hcrit,Ioo_subset_Icc_self hk,hdist,henergy⟩
  have hCount : ∀ M : ℝ, 0 < M → ∃ B : ℝ, 0 < B ∧
      ∀ n : ℕ, originalWindowExpectedCount μ Q d.center M (Icc L R) n ≤
        ENNReal.ofReal B := by
    intro M hM
    obtain ⟨B,hB,hbound⟩ :=
      original_mixed_centered_critical_window_count_bounded μ h.overlap_range.1 d hM
    refine ⟨B,hB,fun n => ?_⟩
    exact (lintegral_mono fun J =>
      physical_window_count_mono_radial n μ Q
        (Icc (d.center n-M) (d.center n+M)) _ _ hInside (fun _ _ => 1) J).trans (hbound n)
  refine ⟨L,R,b₀,hEdge',hL,hR,hb₀,hb₀Q,d.center,τ,D,hτ,⟨{
    overlap_range := h.overlap_range
    scale_pos := hD
    scale_eventually_eq := hDeq
    first_moments := ⟨L₀, R₀, d, rfl⟩
    normalized_center := source_center_normalized h d
    uniform_count := hCount
    count := ?_
    upper := source_center_upper_tight h hnp hEdge hLK hKR d
    coarse := ?_
    C := C
    a := a
    C_pos := hC
    a_pos := ha
    low_sum := ?_
    denominator := denominator_transfer h d dh D hDeq hHeavy }⟩⟩
  · intro M hM
    obtain ⟨B,_hB,hbound⟩ := hCount M hM
    exact (limsup_le_of_le (by isBoundedDefault) (.of_forall hbound)).trans_lt
      ENNReal.ofReal_lt_top
  · intro b hb
    exact MixedCapturePhysicalCoarseDiniAssembly.physical_coarse_cover_of_three_physical_inputs
      μ β (Icc L R) hNorm hMean hRel b hb τ hτ
  · filter_upwards [hLow, hDeq] with n hn hnD
    intro b hb hbb M hM
    rw [hnD]
    have hh := hn b hb (hbb.trans (min_le_left _ _)) M hM
    apply le_trans ?_ hh
    apply lintegral_mono
    intro J
    exact physical_window_count_mono_radial n μ Q
      (Ico (((n+2 : ℕ) : ℝ)*(markE μ β x Q-τ)) (d.center n-M)) _ _
      hInside (sourceMixedBandMark n μ β (Real.sqrt Q) b) J


private theorem capture_of_common_witness
    (μ : FiniteMixture) {β x Q E L R b₀ τ : ℝ} {m D : ℕ → ℝ}
    (hQ : 0 < Q) (w : CommonWitness μ β x Q E L R b₀ m τ D)
    {b : ℝ} (hb : 0 < b) (hbb : b ≤ b₀) :
    Tendsto (fun M : ℝ => limsup (fun n => ∫ J,
      originalBandComplementMass μ Q (m n) M b β (Icc L R) J
        ∂disorderLaw (n+2) μ.maxDegree) atTop) atTop (𝓝 0) := by
  apply original_fixed_window_capture_of_inputs μ hQ E τ b β isClosed_Icc m D w.scale_pos
    (w.coarse b hb) w.upper w.denominator w.C w.a w.a_pos
  intro M hM
  apply limsup_le_of_le (by isBoundedDefault)
  filter_upwards [w.low_sum] with n hn
  have hh := ENNReal.div_le_div_right (hn b hb hbb M hM.le) (ENNReal.ofReal (D n))
  apply hh.trans_eq
  rw [← ENNReal.ofReal_div_of_pos (w.scale_pos n)]
  congr 1
  field_simp [(w.scale_pos n).ne']

/-- Module 7: one compact radial interval, center, band width, coarse
threshold and positive scale satisfy all six source capture inputs. -/
private theorem mixed_capture_common_witness_of_literature
    (μ : FiniteMixture) {β x Q : ℝ}
    (h : Certificate μ β x Q) (hnp : μ.minDegree < μ.maxDegree)
    (hChen : Chen2013FiniteParisi) (hChenSen : ChenSenFiniteGround)
    (h5 : Theorem5 (literatureThermodynamicData hChen hChenSen μ h.beta_pos.le))
    (h25 : Remark25Contrapositive μ β) (h24 : Proposition24 μ β Q) :
    ∃ L R b₀ : ℝ,
      2 * Real.sqrt (Q^2 * μ.xi2 Q) < L ∧
      L < markK μ β Q ∧ markK μ β Q < R ∧
      0 < b₀ ∧ b₀ < Real.sqrt Q ∧
      ∃ (m : ℕ → ℝ) (τ : ℝ) (D : ℕ → ℝ), 0 < τ ∧
        Nonempty (CommonWitness μ β x Q (markE μ β x Q) L R b₀ m τ D) := by
  obtain ⟨L₀,R₀,ε,bLow,C,C₂,Cenv,τ,a,_hε,hbLow,hC,_hC₂,_hCenv,
    hEdge,hLK,hKR,_hband,_hτdef,_hadef,hτ,ha,d,hLow⟩ :=
    source_mixed_band_partition_below_window_sum_borel μ h hnp
  obtain ⟨Lh,Rh,bh,_hEdgeh,_hLh,_hRh,hbh,_hbhQ,dh,hHeavy⟩ :=
    source_mixed_heavy_band_partition_low_probability_unconditional μ h hnp h.min_degree
  have hLow' := hLow τ hτ le_rfl
  have hLow'' : ∀ᶠ n : ℕ in atTop, ∀ b : ℝ, 0 < b → b ≤ bLow →
      ∀ M : ℝ, 0 ≤ M →
        (∫⁻ J, actualScoreWindowCount (n+1)
          (centerCoefficients (mixtureCoefficients μ) Q)
          (physicalEnergyWindow (n+2)
            (Ico (((n+2 : ℕ) : ℝ)*(markE μ β x Q-τ)) (d.center n-M)) (Ioo L₀ R₀))
          (sourceMixedBandMark n μ β (Real.sqrt Q) b) J
          ∂disorderLaw (n+2) μ.maxDegree) ≤
          ENNReal.ofReal (C*sourceCriticalBandScale (n+1) μ h.overlap_range β
            (d.center n)*Real.exp (-a*M)) := by
    filter_upwards [hLow'] with n hn
    intro b hb hbb M hM
    simpa only [mem_univ, ↓reduceIte] using hn b hb hbb M hM univ MeasurableSet.univ
  exact common_witness_of_estimates μ h hnp hChen hChenSen h5 h25 h24
    hEdge hLK hKR hbLow hC hτ ha d hLow'' dh (hHeavy bh hbh le_rfl)



/-- Capture transfers to any first-moment center and any radial interval
about the contact: all high critical points have radial mark in that interval.
The bounded change of center is absorbed before the outer window limit. -/
private theorem capture_at_first_moment_center
    (μ : FiniteMixture) {β x Q L R : ℝ}
    (h : Certificate μ β x Q) (hnp : μ.minDegree < μ.maxDegree)
    (hEdge : sourceRadialEdge μ Q < L)
    (hL : L < markK μ β Q) (hR : markK μ β Q < R)
    (d : SourceMaximumFirstMomentConclusions μ β x Q L R)
    {Ls Rs b₀ τ : ℝ} {m D : ℕ → ℝ}
    (w : CommonWitness μ β x Q (markE μ β x Q) Ls Rs b₀ m τ D)
    {b : ℝ} (hb : 0 < b) (hbb : b ≤ b₀) :
    Tendsto (fun M : ℝ => limsup (fun n => ∫ J,
      originalBandComplementMass μ Q (d.center n) M b β (Icc L R) J
        ∂disorderLaw (n+2) μ.maxDegree) atTop) atTop (𝓝 0) := by
  obtain ⟨La, Ra, ds, hm⟩ := w.first_moments
  have hdiff := source_centers_eventually_bounded_difference d ds
  rw [← hm] at hdiff
  let B := d.log_constant + ds.log_constant
  have hB : 0 < B := add_pos d.log_constant_pos ds.log_constant_pos
  obtain ⟨δ, κ, A, a, hδ, _, hA, ha, Ω, hΩ, hgood, hprob⟩ :=
    MixedHighEnergyAllHigh.mixed_all_high_critical_event μ h hnp hEdge hL hR
  have hbad : Tendsto (fun n => (disorderLaw (n+2) μ.maxDegree).real (Ω n)ᶜ)
      atTop (𝓝 (0 : ℝ)) := by
    apply squeeze_zero' (.of_forall fun _ => measureReal_nonneg) hprob
    have hdim : Tendsto (fun n : ℕ => ((n+2 : ℕ) : ℝ)) atTop atTop :=
      tendsto_natCast_atTop_atTop.comp (tendsto_add_atTop_nat 2)
    simpa only [Function.comp_def, mul_zero] using
      (Real.tendsto_exp_atBot.comp
        (hdim.const_mul_atTop_of_neg (neg_neg_of_pos ha))).const_mul A
  have hcap := capture_of_common_witness μ h.overlap_range.1 w hb hbb
  have hshift : Tendsto (fun M : ℝ => M-B) atTop atTop :=
    tendsto_atTop_add_const_right atTop (-B) tendsto_id
  apply squeeze_zero' (g := fun M : ℝ => limsup (fun n => ∫ J,
    originalBandComplementMass μ Q (m n) (M-B) b β (Icc Ls Rs) J
      ∂disorderLaw (n+2) μ.maxDegree) atTop)
  · refine .of_forall fun M => ?_
    apply le_limsup_of_le (isBoundedUnder_of ⟨1, fun n => ?_⟩)
    · intro z hz
      obtain ⟨n, hn⟩ := hz.exists
      exact (integral_nonneg fun _ => measureReal_nonneg).trans hn
    · apply (integral_mono
        (originalBandComplementMass_integrable (N := n+2) (by omega) μ Q (d.center n) M b β isClosed_Icc)
        (integrable_const (1 : ℝ)) (fun J =>
          (originalBandComplementMass_mem_unit (N := n+2) (by omega) μ Q (d.center n) M b β (Icc L R) J).2)).trans_eq
      simp
  · filter_upwards [eventually_gt_atTop B] with M hM
    have hhigh := normalized_source_center_above_lower_energy
      (mul_pos h.beta_pos h.weight_range.1) ds.log_constant_pos.le hδ
      ds.center ds.logarithmic_correction (-(M-B))
    rw [← hm] at hhigh
    have hle : ∀ᶠ n : ℕ in atTop,
        (∫ J, originalBandComplementMass μ Q (d.center n) M b β (Icc L R) J
          ∂disorderLaw (n+2) μ.maxDegree) ≤
        (∫ J, originalBandComplementMass μ Q (m n) (M-B) b β (Icc Ls Rs) J
          ∂disorderLaw (n+2) μ.maxDegree) +
          (disorderLaw (n+2) μ.maxDegree).real (Ω n)ᶜ := by
      filter_upwards [hdiff, hhigh] with n hn hhighn
      have hi : Integrable ((Ω n)ᶜ.indicator (1 : Disorder (n+2) μ.maxDegree → ℝ))
          (disorderLaw (n+2) μ.maxDegree) :=
        (integrable_const (1 : ℝ)).indicator (hΩ n).compl
      rw [← integral_indicator_one (hΩ n).compl]
      rw [← integral_add
        (f := originalBandComplementMass (N := n+2) μ Q (m n) (M-B) b β (Icc Ls Rs))
        (g := (Ω n)ᶜ.indicator (1 : Disorder (n+2) μ.maxDegree → ℝ))
        (originalBandComplementMass_integrable (N := n+2) (U := Icc Ls Rs)
          (by omega) μ Q (m n) (M-B) b β isClosed_Icc) hi]
      apply integral_mono
        (originalBandComplementMass_integrable (N := n+2) (by omega) μ Q (d.center n) M b β isClosed_Icc)
        ((originalBandComplementMass_integrable (N := n+2) (by omega) μ Q (m n) (M-B) b β isClosed_Icc).add hi)
      intro J
      let := mixtureGibbsLaw_probability (by omega : 1 ≤ n+2) μ β J
      change originalBandComplementMass μ Q (d.center n) M b β (Icc L R) J ≤
        originalBandComplementMass μ Q (m n) (M-B) b β (Icc Ls Rs) J +
          (Ω n)ᶜ.indicator (fun _ => (1 : ℝ)) J
      by_cases hJ : J ∈ Ω n
      · simp only [Set.indicator_of_notMem (show J ∉ (Ω n)ᶜ by simpa only [Set.mem_compl_iff, not_not] using hJ), add_zero]
        unfold originalBandComplementMass
        apply measureReal_mono (compl_subset_compl.mpr ?_) (measure_ne_top _ _)
        rintro σ ⟨⟨u, hu, hband⟩, hσ⟩
        rcases hu with ⟨⟨⟨hu, hcrit⟩, henergy⟩, _⟩
        have hh := (hgood n J hJ).1 u hu hcrit
          (hhighn.trans henergy.1)
        have hwindow : field (centerCoefficients (mixtureCoefficients μ) Q) J u ∈
            Icc (d.center n-M) (d.center n+M) := by
          have hd := abs_le.mp hn
          constructor <;> dsimp [B] at * <;> linarith [henergy.1, henergy.2]
        exact ⟨⟨u, ⟨⟨⟨hu, hcrit⟩, hwindow⟩, Ioo_subset_Icc_self hh.1⟩, hband⟩, hσ⟩
      · simp only [Set.indicator_of_mem (show J ∈ (Ω n)ᶜ from hJ)]
        have hunit := originalBandComplementMass_mem_unit (N := n+2) (by omega)
          μ Q (d.center n) M b β (Icc L R) J
        have hnonneg : 0 ≤ originalBandComplementMass μ Q (m n) (M-B) b β (Icc Ls Rs) J :=
          measureReal_nonneg
        linarith [hunit.2]
    have hh := limsup_le_limsup hle
      (isCoboundedUnder_le_of_le atTop fun _ => integral_nonneg fun _ => measureReal_nonneg)
      (isBoundedUnder_of ⟨2, fun n => by
        have hu : (∫ J, originalBandComplementMass μ Q (m n) (M-B) b β (Icc Ls Rs) J
            ∂disorderLaw (n+2) μ.maxDegree) ≤ 1 := by
          apply (integral_mono
            (originalBandComplementMass_integrable (N := n+2) (by omega) μ Q (m n) (M-B) b β isClosed_Icc)
            (integrable_const (1 : ℝ)) (fun J =>
              (originalBandComplementMass_mem_unit (N := n+2) (by omega) μ Q (m n) (M-B) b β (Icc Ls Rs) J).2)).trans_eq
          simp
        linarith [measureReal_le_one (μ := disorderLaw (n+2) μ.maxDegree) (s := (Ω n)ᶜ)]⟩)
    apply hh.trans
    have hadd := limsup_add_le
      (u := fun n : ℕ => ∫ J,
        originalBandComplementMass μ Q (m n) (M-B) b β (Icc Ls Rs) J
          ∂disorderLaw (n+2) μ.maxDegree)
      (v := fun n => (disorderLaw (n+2) μ.maxDegree).real (Ω n)ᶜ)
      (isBoundedUnder_of ⟨0, fun _ => integral_nonneg fun _ => measureReal_nonneg⟩)
      (isBoundedUnder_of ⟨1, fun n => by
        apply (integral_mono
          (originalBandComplementMass_integrable (N := n+2) (by omega) μ Q (m n) (M-B) b β isClosed_Icc)
          (integrable_const (1 : ℝ)) (fun J =>
            (originalBandComplementMass_mem_unit (N := n+2) (by omega) μ Q (m n) (M-B) b β (Icc Ls Rs) J).2)).trans_eq
        simp⟩)
      (isCoboundedUnder_le_of_le atTop fun _ => measureReal_nonneg)
      hbad.isBoundedUnder_le
    have heq : ((fun n : ℕ => ∫ J,
        originalBandComplementMass μ Q (m n) (M-B) b β (Icc Ls Rs) J
          ∂disorderLaw (n+2) μ.maxDegree) +
        (fun n => (disorderLaw (n+2) μ.maxDegree).real (Ω n)ᶜ)) =
        (fun n => (∫ J, originalBandComplementMass μ Q (m n) (M-B) b β (Icc Ls Rs) J
          ∂disorderLaw (n+2) μ.maxDegree) +
          (disorderLaw (n+2) μ.maxDegree).real (Ω n)ᶜ) := rfl
    rw [heq, hbad.limsup_eq, add_zero] at hadd
    exact hadd
  · exact hcap.comp hshift


/-- The ordinary joint event in `thm:mc-counts` and `lem:mb-counts`.
No antipodal identification is made. -/
def jointGroundEvent (n : ℕ) (μ : FiniteMixture) (Q m M : ℝ) (U : Set ℝ) :
    Set (Disorder (n+3) μ.maxDegree) :=
  {J | (Set.Nonempty {u : Vector (n+3) |
    ‖u‖^2 = (n+3 : ℕ) ∧
    surfaceGradient (field (centerCoefficients (mixtureCoefficients μ) Q) J) u = 0 ∧
    field (centerCoefficients (mixtureCoefficients μ) Q) J u ∈ Icc (m-M) (m+M) ∧
    actualScore (centerCoefficients (mixtureCoefficients μ) Q) J u 1 ∈ U}) ∧
    sourceSphereMaximum (n+1) μ Q J ≤ m+M}

/-- The three printed probability estimates, and the quantitative joint
existence bound, for one literal mixed retained count and one center. -/
def MixedSharpAtWindow (μ : FiniteMixture) (β x Q C cut η ε L R : ℝ)
    (m : ℕ → ℝ) (t : ℝ) : Prop :=
  let E := markE μ β x Q
  let g := (markK μ β Q-2*Real.sqrt (Q^2*μ.xi2 Q))/2
  let G := gap μ Q (markY β Q) (markZ x Q) ε η
  let K n := physicalEnergyWindow (n+3)
    (Icc (m (n+1)-t) (m (n+1)+t)) (Ioo L R)
  let aN n := sourceRetainedScoreWindowMean (n+2) μ Q (K n) (g/2) C ε η E G
  let X n J := (sourceRetainedScoreWindowCount (n+2)
    (centerCoefficients (mixtureCoefficients μ) Q) (K n) (g/2) C ε η E G J).toReal
  let A := Real.exp ((β*x)*t)-Real.exp (-(β*x)*t)
  let k := 1+(1-ε)/(cut^2-ε)
  Filter.limsup (fun n => (disorderLaw (n+3) μ.maxDegree).real
    {J | X n J = 0}) atTop ≤ k/A ∧
  Filter.limsup (fun n => (disorderLaw (n+3) μ.maxDegree).real
    {J | X n J < aN n/2}) atTop ≤ 4*k/A ∧
  Filter.limsup (fun n => (disorderLaw (n+3) μ.maxDegree).real
    {J | |sourceSphereMaximum (n+1) μ Q J-m (n+1)| > t}) atTop ≤
      Real.exp (-(β*x)*t)+k/A ∧
  1-(Real.exp (-(β*x)*t)+k/A) ≤
    Filter.liminf (fun n => (disorderLaw (n+3) μ.maxDegree).real
      (jointGroundEvent n μ Q (m (n+1)) t (Icc L R))) atTop

/-- All clauses of fixed-window counts and Gibbs capture with the same
center and closed radial interval. Dimensions are `N = n+2`; the joint
ground event uses the harmless one-step shift `N = n+3`. -/
structure CountCapturePackage (μ : FiniteMixture) (β x Q L R b₀ : ℝ)
    (m : ℕ → ℝ) : Prop where
  normalized_center : Tendsto (fun n => m n / ((n+2 : ℕ) : ℝ)) atTop
    (𝓝 (markE μ β x Q))
  logarithmic_center : ∃ B : ℝ, 0 < B ∧ ∀ᶠ n : ℕ in atTop,
    |m n-((n+2 : ℕ)*markE μ β x Q-Real.log (n+2 : ℕ)/(2*(β*x)))| ≤ B
  uniform_count : ∀ M : ℝ, 0 < M → ∃ B : ℝ, 0 < B ∧ ∀ n : ℕ,
    originalWindowExpectedCount μ Q m M (Icc L R) n ≤ ENNReal.ofReal B
  joint_ground : Tendsto (fun M : ℝ => Filter.liminf (fun n : ℕ =>
    (disorderLaw (n+3) μ.maxDegree).real
      (jointGroundEvent n μ Q (m (n+1)) M (Icc L R))) atTop) atTop (𝓝 1)
  capture : ∀ b : ℝ, 0 < b → b ≤ b₀ →
    Tendsto (fun M : ℝ => limsup (fun n => ∫ J,
      originalBandComplementMass μ Q (m n) M b β (Icc L R) J
        ∂disorderLaw (n+2) μ.maxDegree) atTop) atTop (𝓝 0)

private theorem mixed_sharp_count_witness
    (μ : FiniteMixture) {β x Q δMax : ℝ}
    (h : Certificate μ β x Q) (hnp : μ.minDegree < μ.maxDegree)
    (hd : 4 ≤ μ.minDegree) (hδMax : 0 < δMax) :
    let g := (markK μ β Q-2*Real.sqrt (Q^2*μ.xi2 Q))/2
    ∃ C cut η ε L R : ℝ,
      0 < C ∧ 0 < cut ∧ cut ≤ 1 ∧
      cut ≤ pairRadius μ h.overlap_range.1 hd ∧
      0 < η ∧ η ≤ sourceCriticalCollarOverlapLoss (g/2) C ∧
      0 < ε ∧ ε < cut^2/2 ∧ ε < 1-η ∧
      L < markK μ β Q ∧ markK μ β Q < R ∧ sourceRadialEdge μ Q < L ∧
      ∃ d : SourceMaximumFirstMomentConclusions μ β x Q L R,
        ∀ t : ℝ, 0 < t → MixedSharpAtWindow μ β x Q C cut η ε L R d.center t := by
  dsimp only
  obtain ⟨C,cut,η,ε,L,R,hC,hcut,hcutOne,hcutRad,hη,hηCollar,
    hε,hεCut,hεη,hL,hR,hEdge,d,hall⟩ :=
    source_mixed_actual_retained_canonical_probability_limsup μ h hnp hd hδMax
  let E := markE μ β x Q
  let g := (markK μ β Q-2*Real.sqrt (Q^2*μ.xi2 Q))/2
  have hm : markK μ β Q ∈ Ioo L R := ⟨hL,hR⟩
  have hκ : 0 < sourceMarkedLeastCurvature μ Q :=
    sourceMarkedLeastCurvature_pos μ h.overlap_range.1 (by omega) hnp
  have hu : 0 < sourceRadialClearance μ β Q (Ioo L R) :=
    sourceRadialClearance_pos μ hm
  let δ := sourceMarkedLeastCurvature μ Q *
    (sourceRadialClearance μ β Q (Ioo L R))^2/(8*(β*x))
  have hδ : 0 < δ := by
    dsimp [δ]
    have hc0 : 0 < β*x := mul_pos h.beta_pos h.weight_range.1
    positivity
  refine ⟨C,cut,η,ε,L,R,hC,hcut,hcutOne,hcutRad,hη,hηCollar,
    hε,hεCut,hεη,hL,hR,hEdge,d,?_⟩
  obtain ⟨D, _hD, hwin⟩ := hall (α := (3 : ℝ)/8) (by norm_num) (by norm_num)
  intro t ht
  let G := gap μ Q (markY β Q) (markZ x Q) ε η
  let a := (1+(1-ε)/(cut^2-ε))/
    (Real.exp ((β*x)*t)-Real.exp (-(β*x)*t))
  have hZero := (hwin t ht).1
  have hUpper := sourceSphereMaximum_centered_probability_limsup_shift
    μ h hnp hEdge hm hδ (le_refl _) d t
  have hTight := source_retained_window_maximum_tightness_of_limsup
    μ Q (fun n => d.center (n+1)) (Ioo L R)
    (g/2) C ε η E G t a (Real.exp (-(β*x)*t)) hZero hUpper
  have hJoint := source_retained_window_joint_probability_of_limsup
    μ Q (fun n => d.center (n+1)) (Ioo L R)
    (g/2) C ε η E G t a (Real.exp (-(β*x)*t)) hZero hUpper
  let pRet (n : ℕ) := (disorderLaw (n+3) μ.maxDegree).real
    {J | (sourceRetainedScoreWindowCount (n+2)
      (centerCoefficients (mixtureCoefficients μ) Q)
      (physicalEnergyWindow (n+3)
        (Icc (d.center (n+1)-t) (d.center (n+1)+t)) (Ioo L R))
      (g/2) C ε η E G J).toReal ≠ 0 ∧
      sourceSphereMaximum (n+1) μ Q J < d.center (n+1)+t}
  let pCrit (n : ℕ) := (disorderLaw (n+3) μ.maxDegree).real
    {J | (Set.Nonempty {u : Vector (n+3) |
      ‖u‖^2=(n+3:ℕ) ∧
      surfaceGradient (field (centerCoefficients (mixtureCoefficients μ) Q) J) u=0 ∧
      field (centerCoefficients (mixtureCoefficients μ) Q) J u ∈
        Icc (d.center (n+1)-t) (d.center (n+1)+t) ∧
      actualScore (centerCoefficients (mixtureCoefficients μ) Q) J u 1 ∈ Ioo L R}) ∧
      sourceSphereMaximum (n+1) μ Q J < d.center (n+1)+t}
  have hpoint : ∀ n, pRet n ≤ pCrit n := by
    intro n
    apply measureReal_mono
    · intro J hJ
      refine ⟨source_retained_nonzero_critical_window_nonempty n μ Q
        (d.center (n+1)-t) (d.center (n+1)+t) (g/2) C ε η E G
        (Ioo L R) J hJ.1,hJ.2⟩
    · finiteness
  have hRetBound : IsBoundedUnder (· ≥ ·) atTop pRet :=
    isBoundedUnder_of ⟨0,fun n => measureReal_nonneg⟩
  have hCritCob : IsCoboundedUnder (· ≥ ·) atTop pCrit :=
    (isBoundedUnder_of ⟨(1:ℝ),fun n => measureReal_le_one⟩ :
      IsBoundedUnder (· ≤ ·) atTop pCrit).isCoboundedUnder_ge
  have hTransfer := Filter.liminf_le_liminf (Eventually.of_forall hpoint)
    hRetBound hCritCob
  have hLow := hJoint.trans hTransfer
  refine ⟨(hwin t ht).1, (hwin t ht).2, ?_, ?_⟩
  · exact hTight
  · apply hLow.trans
    apply Filter.liminf_le_liminf (Eventually.of_forall fun n => ?_)
      (isBoundedUnder_of ⟨0, fun _ => measureReal_nonneg⟩)
      (isBoundedUnder_of ⟨(1 : ℝ), fun _ => measureReal_le_one⟩).isCoboundedUnder_ge
    apply measureReal_mono _ (measure_ne_top _ _)
    rintro J ⟨⟨u, hu, hc, he, hk⟩, hmax⟩
    exact ⟨⟨u, hu, hc, he, Ioo_subset_Icc_self hk⟩, hmax.le⟩


private theorem joint_limit_of_sharp
    (μ : FiniteMixture) {β x Q C cut η ε L R : ℝ}
    (h : Certificate μ β x Q) (m : ℕ → ℝ)
    (hs : ∀ t : ℝ, 0 < t → MixedSharpAtWindow μ β x Q C cut η ε L R m t) :
    Tendsto (fun M : ℝ => Filter.liminf (fun n : ℕ =>
      (disorderLaw (n+3) μ.maxDegree).real
        (jointGroundEvent n μ Q (m (n+1)) M (Icc L R))) atTop) atTop (𝓝 1) := by
  have hl := (source_canonical_ground_error_tendsto_zero (β*x)
    (1+(1-ε)/(cut^2-ε)) (mul_pos h.beta_pos h.weight_range.1)).const_sub 1
  simp only [sub_zero] at hl
  apply hl.squeeze' tendsto_const_nhds
  · filter_upwards [eventually_gt_atTop (0 : ℝ)] with t ht
    exact (hs t ht).2.2.2
  · exact .of_forall fun t =>
      liminf_le_of_le (isBoundedUnder_of ⟨0, fun _ => measureReal_nonneg⟩)
        (fun b hb => by obtain ⟨n, hn⟩ := hb.exists; exact hn.trans measureReal_le_one)

/-- The count and joint-ground clauses require no literature hypothesis.
The center is the tail-equals-one center stored in the first-moment record,
and the zero, half-mean, and maximum bounds share its selection parameters. -/
theorem mixed_critical_window_counts
    (μ : FiniteMixture) {β x Q δMax : ℝ}
    (h : Certificate μ β x Q) (hnp : μ.minDegree < μ.maxDegree)
    (hδMax : 0 < δMax) :
    ∃ C cut η ε L R : ℝ,
      0 < C ∧ 0 < cut ∧ cut ≤ 1 ∧
      cut ≤ pairRadius μ h.overlap_range.1 h.min_degree ∧
      0 < η ∧ η ≤ sourceCriticalCollarOverlapLoss
        ((markK μ β Q-2*Real.sqrt (Q^2*μ.xi2 Q))/2/2) C ∧
      0 < ε ∧ ε < cut^2/2 ∧ ε < 1-η ∧
      L < markK μ β Q ∧ markK μ β Q < R ∧ sourceRadialEdge μ Q < L ∧
      ∃ d : SourceMaximumFirstMomentConclusions μ β x Q L R,
        (∀ M : ℝ, 0 < M → ∃ B : ℝ, 0 < B ∧ ∀ n : ℕ,
          originalWindowExpectedCount μ Q d.center M (Icc L R) n ≤ ENNReal.ofReal B) ∧
        Tendsto (fun M : ℝ => Filter.liminf (fun n : ℕ =>
          (disorderLaw (n+3) μ.maxDegree).real
            (jointGroundEvent n μ Q (d.center (n+1)) M (Icc L R))) atTop)
          atTop (𝓝 1) ∧
        ∀ t : ℝ, 0 < t → MixedSharpAtWindow μ β x Q C cut η ε L R d.center t := by
  obtain ⟨C, cut, η, ε, L, R, hC, hcut, hcutOne, hcutRad, hη,
    hηCollar, hε, hεCut, hεη, hL, hR, hEdge, d, hs⟩ :=
    mixed_sharp_count_witness μ h hnp h.min_degree hδMax
  refine ⟨C, cut, η, ε, L, R, hC, hcut, hcutOne, hcutRad, hη,
    hηCollar, hε, hεCut, hεη, hL, hR, hEdge, d, ?_,
    joint_limit_of_sharp μ h d.center hs, hs⟩
  intro M hM
  obtain ⟨B, hB, hbound⟩ := original_mixed_centered_critical_window_count_bounded
    μ h.overlap_range.1 d hM
  refine ⟨B, hB, fun n => ?_⟩
  rw [originalWindowExpectedCount_closed_eq_open μ h.overlap_range.1 hnp]
  exact hbound n

/-- Manuscript `thm:mc-counts`, `lem:mb-counts`, and `thm:mb-capture`
for a non-pure finite mixture, on one closed radial interval and one
explicitly tail-normalized center. All three printed probability constants
are retained for the literal selected count. Only Gibbs capture uses the
five literature interfaces. -/
theorem mixed_count_capture_package_of_literature
    (μ : FiniteMixture) {β x Q : ℝ}
    (h : Certificate μ β x Q) (hnp : μ.minDegree < μ.maxDegree)
    (hChen : Chen2013FiniteParisi) (hChenSen : ChenSenFiniteGround)
    (h5 : Theorem5 (literatureThermodynamicData hChen hChenSen μ h.beta_pos.le))
    (h25 : Remark25Contrapositive μ β) (h24 : Proposition24 μ β Q) :
    ∃ C cut η ε L R b₀ : ℝ,
      0 < C ∧ 0 < cut ∧ cut ≤ 1 ∧
      cut ≤ pairRadius μ h.overlap_range.1 h.min_degree ∧
      0 < η ∧ η ≤ sourceCriticalCollarOverlapLoss
        ((markK μ β Q-2*Real.sqrt (Q^2*μ.xi2 Q))/2/2) C ∧
      0 < ε ∧ ε < cut^2/2 ∧ ε < 1-η ∧
      sourceRadialEdge μ Q < L ∧ L < markK μ β Q ∧ markK μ β Q < R ∧
      0 < b₀ ∧ b₀ < Real.sqrt Q ∧
      ∃ d : SourceMaximumFirstMomentConclusions μ β x Q L R,
        CountCapturePackage μ β x Q L R b₀ d.center ∧
        ∀ t : ℝ, 0 < t → MixedSharpAtWindow μ β x Q C cut η ε L R d.center t := by
  obtain ⟨C, cut, η, ε, L, R, hC, hcut, hcutOne, hcutRad, hη,
    hηCollar, hε, hεCut, hεη, hL, hR, hEdge, d, hs⟩ :=
    mixed_sharp_count_witness μ h hnp h.min_degree (δMax := 1) (by norm_num)
  obtain ⟨Ls, Rs, b₀, _hEdges, _hLs, _hRs, hb₀, hb₀Q, m, τ, D, _hτ, ⟨w⟩⟩ :=
    mixed_capture_common_witness_of_literature μ h hnp hChen hChenSen h5 h25 h24
  refine ⟨C, cut, η, ε, L, R, b₀, hC, hcut, hcutOne, hcutRad, hη,
    hηCollar, hε, hεCut, hεη, hEdge, hL, hR, hb₀, hb₀Q, d, ?_, hs⟩
  refine ⟨source_center_normalized h d, ⟨d.log_constant, d.log_constant_pos,
    d.logarithmic_correction⟩, ?_, joint_limit_of_sharp μ h d.center hs, ?_⟩
  · intro M hM
    obtain ⟨B, hB, hbound⟩ := original_mixed_centered_critical_window_count_bounded
      μ h.overlap_range.1 d hM
    refine ⟨B, hB, fun n => ?_⟩
    rw [originalWindowExpectedCount_closed_eq_open μ h.overlap_range.1 hnp]
    exact hbound n
  · intro b hb hbb
    exact capture_at_first_moment_center μ h hnp hEdge hL hR d w hb hbb


