/-- The affine parameter coordinate between the rational endpoints. -/
def parameterWeight (t : ℝ) : ℝ := 50000 * t - 4539 / 2

lemma parameterWeight_mem (t : ℝ) (ht : t ∈ Set.Icc tMinus tPlus) :
    0 ≤ parameterWeight t ∧ parameterWeight t ≤ 1 := by
  unfold parameterWeight
  norm_num [tMinus, tPlus] at ht
  constructor <;> linarith [ht.1, ht.2]

lemma P_interpolation (t r : ℝ) :
    P t r = (1 - parameterWeight t) * P tMinus r + parameterWeight t * P tPlus r := by
  unfold P parameterWeight tMinus tPlus
  ring

lemma D_interpolation (t r : ℝ) :
    D t r = (1 - parameterWeight t) * D tMinus r + parameterWeight t * D tPlus r := by
  unfold D parameterWeight tMinus tPlus
  ring

lemma interpolate_lower (a b w L : ℝ) (hw0 : 0 ≤ w) (hw1 : w ≤ 1)
    (ha : L ≤ a) (hb : L ≤ b) : L ≤ (1 - w) * a + w * b := by
  nlinarith [mul_nonneg (sub_nonneg.mpr hw1) (sub_nonneg.mpr ha),
    mul_nonneg hw0 (sub_nonneg.mpr hb)]

/-- The four uniform sign-and-margin bounds of Appendix A, Lemma A.3. -/
theorem polynomial_sign_bounds (t : ℝ) (ht : t ∈ Set.Icc tMinus tPlus) :
    (∀ r ∈ Set.Icc (0 : ℝ) (357 / 1000) ∪ Set.Icc (892 / 1000 : ℝ) 1,
      (2 / 25 : ℝ) < P t r) ∧
    (∀ r ∈ Set.Icc (359 / 1000 : ℝ) (890 / 1000), P t r < -(1 / 25 : ℝ)) ∧
    (∀ r ∈ Set.Icc (357 / 1000 : ℝ) (359 / 1000), D t r < -86) ∧
    (∀ r ∈ Set.Icc (890 / 1000 : ℝ) (892 / 1000), (73 : ℝ) < D t r) := by
  obtain ⟨hw0, hw1⟩ := parameterWeight_mem t ht
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro r hr
    rcases hr with hr | hr
    · have h0 := bound_left_minus r hr
      have h1 := bound_left_plus r hr
      have h := interpolate_lower (P tMinus r) (P tPlus r) (parameterWeight t)
        (93 / 1000) hw0 hw1 h0 (by linarith)
      rw [← P_interpolation] at h
      linarith
    · norm_num at hr
      have h0 := bound_right_minus r hr
      have h1 := bound_right_plus r hr
      have h := interpolate_lower (P tMinus r) (P tPlus r) (parameterWeight t)
        (92 / 1000) hw0 hw1 h0 h1
      rw [← P_interpolation] at h
      linarith
  · intro r hr
    norm_num at hr
    have h0 := bound_middle_minus r hr
    have h1 := bound_middle_plus r hr
    have h := interpolate_lower (-(P tMinus r)) (-(P tPlus r)) (parameterWeight t)
      (56 / 1000) hw0 hw1 h0 (by linarith)
    have hi := P_interpolation t r
    nlinarith
  · intro r hr
    have h0 := bound_falling_minus r hr
    have h1 := bound_falling_plus r hr
    have h := interpolate_lower (-(D tMinus r)) (-(D tPlus r)) (parameterWeight t)
      (87410 / 1000) hw0 hw1 h0 h1
    have hi := D_interpolation t r
    nlinarith
  · intro r hr
    norm_num at hr
    have h0 := bound_rising_minus r hr
    have h1 := bound_rising_plus r hr
    have h := interpolate_lower (D tMinus r) (D tPlus r) (parameterWeight t)
      (74529 / 1000) hw0 hw1 (by linarith) h1
    rw [← D_interpolation] at h
    linarith

/-- The displayed derivative is the actual derivative of `P`. -/
theorem P_hasDerivAt (t r : ℝ) : HasDerivAt (P t) (D t r) r := by
  have h2 := (hasDerivAt_id r).pow 2
  have h3 := (hasDerivAt_id r).pow 3
  have h4 := (hasDerivAt_id r).pow 4
  have h10 := (hasDerivAt_id r).pow 10
  have h11 := (hasDerivAt_id r).pow 11
  have h12 := (hasDerivAt_id r).pow 12
  have h := ((((((hasDerivAt_const r (24 + 72 * t)).sub (h2.const_mul 432)).add
    (h3.const_mul 720)).sub (h4.const_mul 300)).sub (h10.const_mul (4752 * t))).add
    (h11.const_mul (7920 * t))).sub (h12.const_mul (3300 * t))
  convert h using 1 <;> try funext x
  all_goals norm_num [P, D] <;> ring

lemma P_continuous (t : ℝ) : Continuous (P t) :=
  continuous_iff_continuousAt.mpr fun r => (P_hasDerivAt t r).continuousAt

/-- The two transition bands are strictly monotone in opposite directions. -/
theorem transition_monotonicity (t : ℝ) (ht : t ∈ Set.Icc tMinus tPlus) :
    StrictAntiOn (P t) (Set.Icc (357 / 1000 : ℝ) (359 / 1000)) ∧
    StrictMonoOn (P t) (Set.Icc (890 / 1000 : ℝ) (892 / 1000)) := by
  obtain ⟨_, _, hfall, hrise⟩ := polynomial_sign_bounds t ht
  constructor
  · apply strictAntiOn_of_deriv_neg (convex_Icc _ _) (P_continuous t).continuousOn
    intro r hr
    rw [(P_hasDerivAt t r).deriv]
    have h := hfall r (interior_subset hr)
    linarith
  · apply strictMonoOn_of_deriv_pos (convex_Icc _ _) (P_continuous t).continuousOn
    intro r hr
    rw [(P_hasDerivAt t r).deriv]
    have h := hrise r (interior_subset hr)
    linarith

/-- `P_t` has exactly two simple zeros in `[0,1]`, with the certified locations. -/
theorem exactly_two_simple_zeros (t : ℝ) (ht : t ∈ Set.Icc tMinus tPlus) :
    ∃ a b : ℝ,
      a ∈ Set.Ioo (357 / 1000 : ℝ) (359 / 1000) ∧
      b ∈ Set.Ioo (890 / 1000 : ℝ) (892 / 1000) ∧
      P t a = 0 ∧ P t b = 0 ∧ D t a < 0 ∧ 0 < D t b ∧
      (∀ r ∈ Set.Icc (0 : ℝ) 1, P t r = 0 ↔ r = a ∨ r = b) := by
  obtain ⟨hpos, hneg, hfall, hrise⟩ := polynomial_sign_bounds t ht
  obtain ⟨hanti, hmono⟩ := transition_monotonicity t ht
  have hA : 0 < P t (357 / 1000) := by
    have h := hpos (357 / 1000) (Or.inl (by constructor <;> norm_num))
    linarith
  have hB : P t (359 / 1000) < 0 := by
    have h := hneg (359 / 1000) (by constructor <;> norm_num)
    linarith
  have hC : P t (890 / 1000) < 0 := by
    have h := hneg (890 / 1000) (by constructor <;> norm_num)
    linarith
  have hD : 0 < P t (892 / 1000) := by
    have h := hpos (892 / 1000) (Or.inr (by constructor <;> norm_num))
    linarith
  obtain ⟨a, ha, hpa⟩ := intermediate_value_Icc'
    (by norm_num : (357 / 1000 : ℝ) ≤ 359 / 1000)
    (P_continuous t).continuousOn ⟨le_of_lt hB, le_of_lt hA⟩
  obtain ⟨b, hb, hpb⟩ := intermediate_value_Icc
    (by norm_num : (890 / 1000 : ℝ) ≤ 892 / 1000)
    (P_continuous t).continuousOn ⟨le_of_lt hC, le_of_lt hD⟩
  have ha' : a ∈ Set.Ioo (357 / 1000 : ℝ) (359 / 1000) := by
    constructor
    · have hne : (357 / 1000 : ℝ) ≠ a := by intro he; rw [← he] at hpa; linarith
      exact lt_of_le_of_ne ha.1 hne
    · have hne : a ≠ (359 / 1000 : ℝ) := by intro he; rw [he] at hpa; linarith
      exact lt_of_le_of_ne ha.2 hne
  have hb' : b ∈ Set.Ioo (890 / 1000 : ℝ) (892 / 1000) := by
    constructor
    · have hne : (890 / 1000 : ℝ) ≠ b := by intro he; rw [← he] at hpb; linarith
      exact lt_of_le_of_ne hb.1 hne
    · have hne : b ≠ (892 / 1000 : ℝ) := by intro he; rw [he] at hpb; linarith
      exact lt_of_le_of_ne hb.2 hne
  refine ⟨a, b, ha', hb', hpa, hpb, ?_, ?_, ?_⟩
  · have h := hfall a ha
    linarith
  · have h := hrise b hb
    linarith
  · intro r hr
    constructor
    · intro hzero
      by_cases h1 : r ≤ (357 / 1000 : ℝ)
      · have h := hpos r (Or.inl ⟨hr.1, h1⟩)
        linarith
      · by_cases h2 : r ≤ (359 / 1000 : ℝ)
        · exact Or.inl (hanti.injOn ⟨le_of_lt (lt_of_not_ge h1), h2⟩ ha (hzero.trans hpa.symm))
        · by_cases h3 : r ≤ (890 / 1000 : ℝ)
          · have h := hneg r ⟨le_of_lt (lt_of_not_ge h2), h3⟩
            linarith
          · by_cases h4 : r ≤ (892 / 1000 : ℝ)
            · exact Or.inr (hmono.injOn ⟨le_of_lt (lt_of_not_ge h3), h4⟩ hb (hzero.trans hpb.symm))
            · have h := hpos r (Or.inr ⟨le_of_lt (lt_of_not_ge h4), hr.2⟩)
              linarith
    · rintro (rfl | rfl) <;> assumption


/-- The complete zero location, simplicity, uniqueness and sign conclusion of Lemma A.3. -/
theorem two_simple_zeros_sign_pattern (t : ℝ) (ht : t ∈ Set.Icc tMinus tPlus) :
    ∃ a b : ℝ,
      a ∈ Set.Ioo (357 / 1000 : ℝ) (359 / 1000) ∧
      b ∈ Set.Ioo (890 / 1000 : ℝ) (892 / 1000) ∧
      a < b ∧ P t a = 0 ∧ P t b = 0 ∧ D t a < 0 ∧ 0 < D t b ∧
      (∀ r ∈ Set.Icc (0 : ℝ) 1, P t r = 0 ↔ r = a ∨ r = b) ∧
      (∀ r ∈ Set.Ico (0 : ℝ) a ∪ Set.Ioc b 1, 0 < P t r) ∧
      (∀ r ∈ Set.Ioo a b, P t r < 0) := by
  obtain ⟨a, b, ha, hb, hpa, hpb, hda, hdb, hzeros⟩ := exactly_two_simple_zeros t ht
  obtain ⟨hpos, hneg, _, _⟩ := polynomial_sign_bounds t ht
  obtain ⟨hanti, hmono⟩ := transition_monotonicity t ht
  have haBand : a ∈ Set.Icc (357 / 1000 : ℝ) (359 / 1000) :=
    ⟨le_of_lt ha.1, le_of_lt ha.2⟩
  have hbBand : b ∈ Set.Icc (890 / 1000 : ℝ) (892 / 1000) :=
    ⟨le_of_lt hb.1, le_of_lt hb.2⟩
  refine ⟨a, b, ha, hb, (by linarith [ha.2, hb.1]), hpa, hpb, hda, hdb, hzeros, ?_, ?_⟩
  · intro r hr
    rcases hr with hr | hr
    · by_cases hA : r ≤ (357 / 1000 : ℝ)
      · have h := hpos r (Or.inl ⟨hr.1, hA⟩)
        linarith
      · have hrBand : r ∈ Set.Icc (357 / 1000 : ℝ) (359 / 1000) := by
          constructor <;> linarith [ha.2, hr.2]
        have h := hanti hrBand haBand hr.2
        rw [hpa] at h
        exact h
    · by_cases hD : (892 / 1000 : ℝ) ≤ r
      · have h := hpos r (Or.inr ⟨hD, hr.2⟩)
        linarith
      · have hrBand : r ∈ Set.Icc (890 / 1000 : ℝ) (892 / 1000) := by
          constructor <;> linarith [hb.1, hr.1]
        have h := hmono hbBand hrBand hr.1
        rw [hpb] at h
        exact h
  · intro r hr
    by_cases hB : r ≤ (359 / 1000 : ℝ)
    · have hrBand : r ∈ Set.Icc (357 / 1000 : ℝ) (359 / 1000) := by
        constructor <;> linarith [ha.1, hr.1]
      have h := hanti haBand hrBand hr.1
      rw [hpa] at h
      exact h
    · by_cases hC : r ≤ (890 / 1000 : ℝ)
      · have h := hneg r (by constructor <;> linarith)
        linarith
      · have hrBand : r ∈ Set.Icc (890 / 1000 : ℝ) (892 / 1000) := by
          constructor <;> linarith [hb.2, hr.2]
        have h := hmono hrBand hbBand hr.2
        rw [hpb] at h
        exact h


/-- Thirteen terms of the positive logarithm series, as an exact real rational. -/
def S13 : ℝ := 2 * ∑ k ∈ Finset.range 13, (5 / 7 : ℝ) ^ (2 * k + 1) / (2 * k + 1)

/-- The elementary geometric upper bound on the omitted series tail. -/
def R13 : ℝ := 2 * (5 / 7 : ℝ) ^ 27 / (27 * (1 - (5 / 7 : ℝ) ^ 2))

/-- Inverse parameter transformation in Appendix A. -/
def L (u : ℝ) : ℝ := (45 + 85 * u) / (24 + 72 * u)

/-- These are the rational comparisons needed before bounding `Real.log 6`. -/
theorem rational_log_sandwich :
    (85 / 72 : ℝ) < S13 ∧ L tPlus < S13 ∧ S13 < S13 + R13 ∧
      S13 + R13 < L tMinus := by
  norm_num [S13, R13, L, tMinus, tPlus, Finset.sum_range_succ]

/-- Exact endpoint values of the inverse transformation. -/
theorem inverse_endpoint_values :
    L tPlus = (4885985 / 2726952 : ℝ) ∧ L tMinus = (1628605 / 908936 : ℝ) := by
  norm_num [L, tMinus, tPlus]

/-- The three rational comparisons at the end of Appendix A. -/
theorem final_rational_comparisons :
    (12 + 132 * tPlus) / (24 + 72 * tPlus) = (149951 / 227246 : ℝ) ∧
    (149951 / 227246 : ℝ) < 2 / 3 ∧
    (1 / 4 : ℝ) < 11 * tMinus * (25 / 27 : ℝ) ^ 8 ∧
    11 * tPlus * (25 / 27 : ℝ) ^ 8 < (3 / 10 : ℝ) := by
  norm_num [tMinus, tPlus]

end
