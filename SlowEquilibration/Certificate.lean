/-!
# Exact rational Bernstein certificate for the nonconvex example

The endpoint vectors below are generated by the rational formula in Appendix A.
Lean checks each of their 126 strict inequalities and their polynomial basis
identities. Their values are then enclosed on the whole spatial interval by
nonnegative Bernstein weights, and on the whole parameter interval by affine
interpolation. No numerical oracle or unproved assertion is used.
-/

@[expose] public section

namespace SlowEquilibration.Certificate
noncomputable section

/-- Lower endpoint of the manuscript's rational parameter enclosure. -/
def tMinus : ℝ := 4539 / 100000
/-- Upper endpoint of the manuscript's rational parameter enclosure. -/
def tPlus : ℝ := 4541 / 100000

/-- The degree twelve polynomial from equation (A.5). -/
def P (t r : ℝ) : ℝ :=
  24 + 72 * t - 432 * r ^ 2 + 720 * r ^ 3 - 300 * r ^ 4 -
    4752 * t * r ^ 10 + 7920 * t * r ^ 11 - 3300 * t * r ^ 12

/-- Its explicitly differentiated polynomial. -/
def D (t r : ℝ) : ℝ :=
  -864 * r + 2160 * r ^ 2 - 1200 * r ^ 3 -
    47520 * t * r ^ 9 + 87120 * t * r ^ 10 - 39600 * t * r ^ 11

/-- Degree `n` Bernstein basis, indexed by `Fin (n + 1)`. -/
def bernsteinWeight (n : ℕ) (k : Fin (n + 1)) (v : ℝ) : ℝ :=
  (n.choose k.val : ℝ) * v ^ k.val * (1 - v) ^ (n - k.val)

lemma bernsteinWeight_nonneg (n : ℕ) (k : Fin (n + 1)) (v : ℝ)
    (hv0 : 0 ≤ v) (hv1 : v ≤ 1) : 0 ≤ bernsteinWeight n k v := by
  unfold bernsteinWeight
  exact mul_nonneg (mul_nonneg (Nat.cast_nonneg _) (pow_nonneg hv0 _))
    (pow_nonneg (sub_nonneg.mpr hv1) _)

/-- Bernstein basis weights form a partition of unity, in every degree. -/
lemma bernsteinWeight_sum (n : ℕ) (v : ℝ) :
    (∑ k : Fin (n + 1), bernsteinWeight n k v) = 1 := by
  have h := congrArg (Polynomial.eval v) (bernsteinPolynomial.sum ℝ n)
  simpa [Polynomial.eval_finsetSum, Finset.sum_range, bernsteinPolynomial,
    bernsteinWeight] using h

lemma bernsteinWeight_sum12 (v : ℝ) :
    (∑ k : Fin 13, bernsteinWeight 12 k v) = 1 := bernsteinWeight_sum 12 v

lemma bernsteinWeight_sum11 (v : ℝ) :
    (∑ k : Fin 12, bernsteinWeight 11 k v) = 1 := bernsteinWeight_sum 11 v

/-- A finite convex combination preserves a common lower bound. -/
lemma weighted_lower_bound {ι : Type*} [Fintype ι] (c w : ι → ℝ) (L : ℝ)
    (hw : ∀ i, 0 ≤ w i) (hs : (∑ i, w i) = 1) (hc : ∀ i, L ≤ c i) :
    L ≤ ∑ i, c i * w i := by
  calc
    L = ∑ i, L * w i := by rw [← Finset.mul_sum, hs, mul_one]
    _ ≤ ∑ i, c i * w i := Finset.sum_le_sum fun i _ =>
      mul_le_mul_of_nonneg_right (hc i) (hw i)

/-- A Bernstein expansion is enclosed by any bounds on all its coefficients. -/
theorem bernstein_enclosure (n : ℕ) (c : Fin (n + 1) → ℝ) (v m M : ℝ)
    (hv0 : 0 ≤ v) (hv1 : v ≤ 1) (hc : ∀ k, m ≤ c k ∧ c k ≤ M) :
    m ≤ (∑ k, c k * bernsteinWeight n k v) ∧
      (∑ k, c k * bernsteinWeight n k v) ≤ M := by
  constructor
  · exact weighted_lower_bound c (fun k => bernsteinWeight n k v) m
      (fun k => bernsteinWeight_nonneg n k v hv0 hv1) (bernsteinWeight_sum n v)
      (fun k => (hc k).1)
  · calc
      (∑ k, c k * bernsteinWeight n k v) ≤ ∑ k, M * bernsteinWeight n k v :=
        Finset.sum_le_sum fun k _ => mul_le_mul_of_nonneg_right (hc k).2
          (bernsteinWeight_nonneg n k v hv0 hv1)
      _ = M := by rw [← Finset.mul_sum, bernsteinWeight_sum, mul_one]

/-- Signed endpoint Bernstein vector on `[0, 357/1000]`. -/
def coefficients_left_minus : Fin 13 → ℝ :=
  ![(340851 / 12500 : ℝ),
    (340851 / 12500 : ℝ),
    (36346569 / 1375000 : ℝ),
    (6228587967 / 250000000 : ℝ),
    (12566726093733 / 550000000000 : ℝ),
    (2240239038933 / 110000000000 : ℝ),
    (1934391261999 / 110000000000 : ℝ),
    (1607850100731 / 110000000000 : ℝ),
    (635790442371 / 55000000000 : ℝ),
    (2338665151179 / 275000000000 : ℝ),
    (69124216229783405518871956831516101 / 12500000000000000000000000000000000 : ℝ),
    (13532797461178006458833218566216268191 / 5000000000000000000000000000000000000 : ℝ),
    (93049269816059444796403251320314085013 / 1000000000000000000000000000000000000000 : ℝ)]

/-- Exact integer margin in the manuscript's coefficient table. -/
theorem coefficients_left_minus_margin (k : Fin 13) :
    (93 / 1000 : ℝ) < coefficients_left_minus k := by
  fin_cases k <;> norm_num [coefficients_left_minus]

/-- Exact polynomial identity certifying the Bernstein conversion. -/
theorem expansion_left_minus (r : ℝ) :
    P tMinus r = ∑ k : Fin 13, coefficients_left_minus k *
      bernsteinWeight 12 k ((r - 0) / ((357 / 1000 : ℝ) - 0)) := by
  simp only [Fin.sum_univ_succ, Fin.sum_univ_zero]
  norm_num [coefficients_left_minus, bernsteinWeight, Nat.choose,
    P, D, tMinus, tPlus]
  ring

/-- A common coefficient lower bound gives a bound at every spatial point. -/
theorem bound_left_minus (r : ℝ)
    (hr : r ∈ Set.Icc 0 (357 / 1000 : ℝ)) :
    (93 / 1000 : ℝ) ≤ P tMinus r := by
  have hv0 : 0 ≤ (r - 0) / ((357 / 1000 : ℝ) - 0) := by
    apply div_nonneg
    · linarith [hr.1]
    · norm_num
  have hv1 : (r - 0) / ((357 / 1000 : ℝ) - 0) ≤ 1 := by
    apply (div_le_one₀ (by norm_num : (0 : ℝ) < (357 / 1000 : ℝ) - 0)).mpr
    linarith [hr.2]
  rw [expansion_left_minus]
  exact weighted_lower_bound (coefficients_left_minus)
    (fun k => bernsteinWeight 12 k ((r - 0) / ((357 / 1000 : ℝ) - 0)))
    (93 / 1000) (fun k => bernsteinWeight_nonneg 12 k _ hv0 hv1)
    (bernsteinWeight_sum12 _) (fun k => le_of_lt (coefficients_left_minus_margin k))

