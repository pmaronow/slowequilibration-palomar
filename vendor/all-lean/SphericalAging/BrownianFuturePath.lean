module

public import SphericalAging.VectorBrownian
public import Mathlib.Probability.Process.FiniteDimensionalLaws

public section

/-! The entire future Brownian path, with its genuine Wiener law and
independence from the complete vector past. These facts concern paths,
not only individual increments, and supply the probabilistic input for
restarting a measurable solution family. -/
noncomputable section
open MeasureTheory ProbabilityTheory MeasurableSpace Set
open scoped NNReal ENNReal
namespace SphericalAging.BrownianFuturePath
open VectorBrownian
set_option maxHeartbeats 900000

/-- The continuous increment path after a deterministic waiting time. -/
@[expose] def scalarFuture (s : ℝ≥0) (ω : Path) : Path :=
  ⟨fun t => ω (s+t)-ω s, (ω.continuous.comp (continuous_const.add continuous_id)).sub continuous_const⟩

lemma scalarFuture_measurable (s : ℝ≥0) : Measurable (scalarFuture s) := by
  rw [ContinuousMap.measurable_iff_eval]
  intro t
  exact (scalar_eval_measurable (s+t)).sub (scalar_eval_measurable s)

/-- Continuous-path Borel sets are generated by the evaluation maps. -/
lemma path_measurableSpace :
    (inferInstance : MeasurableSpace Path) =
      MeasurableSpace.comap (fun ω : Path => (fun t => ω t)) inferInstance := by
  rw [ContinuousMap.measurableSpace_eq_iSup_comap_eval]
  simp only [MeasurableSpace.pi, MeasurableSpace.comap_iSup, MeasurableSpace.comap_comp,Function.comp_def]

/-- Equality of continuous-path laws follows from equality after evaluation.
No measurability of the set of all continuous functions in the unrestricted
uncountable product space is needed. -/
lemma measure_eq_of_eval_map_eq {μ ν : Measure Path}
    (h : μ.map (fun ω : Path => (fun t => ω t)) =
      ν.map (fun ω : Path => (fun t => ω t))) : μ = ν := by
  apply Measure.ext
  intro S hS
  have hS' : @MeasurableSet Path
      (MeasurableSpace.comap (fun ω : Path => (fun t => ω t)) inferInstance) S :=
    path_measurableSpace ▸ hS
  obtain ⟨A,hA,rfl⟩ := measurableSet_comap.mp hS'
  have hm : Measurable (fun ω : Path => (fun t => ω t)) :=
    measurable_pi_iff.mpr scalar_eval_measurable
  rw [← Measure.map_apply hm hA,h,Measure.map_apply hm hA]

/-- The actual future increment path has the same full Wiener law. -/
theorem scalarFuture_map (s : ℝ≥0) : pathLaw.map (scalarFuture s) = pathLaw := by
  apply measure_eq_of_eval_map_eq
  rw [Measure.map_map (measurable_pi_iff.mpr scalar_eval_measurable) (scalarFuture_measurable s)]
  apply (map_eq_iff_forall_finset_map_restrict_eq
    ((measurable_pi_iff.mpr (fun t => (scalar_eval_measurable (s+t)).sub
      (scalar_eval_measurable s))).aemeasurable)
    ((measurable_pi_iff.mpr scalar_eval_measurable).aemeasurable)).mpr
  intro I
  exact ((scalar_isPreBrownian.shift s).hasLaw I).map_eq.trans
    (scalar_isPreBrownian.hasLaw I).map_eq.symm

/-- Entire future paths are independent of the scalar past. -/
theorem scalarFuture_indep_past (s : ℝ≥0) :
    IndepFun (scalarFuture s) (fun (ω : Path) (u : Iic s) => ω u) pathLaw := by
  rw [IndepFun_iff_Indep]
  change Indep ((inferInstance : MeasurableSpace Path).comap (scalarFuture s)) _ _
  have he : (inferInstance : MeasurableSpace Path).comap (scalarFuture s) =
      MeasurableSpace.comap (fun (ω : Path) t => ω (s+t)-ω s) inferInstance :=
    (congrArg (MeasurableSpace.comap (scalarFuture s)) path_measurableSpace).trans
      MeasurableSpace.comap_comp
  exact he.symm ▸ (IndepFun_iff_Indep _ _ _).mp (scalar_isPreBrownian.indepFun_shift s)

/-- The actual vector future increment path. -/
@[expose] def future {N : ℕ} (s : ℝ≥0) (ω : Space N) : Space N := fun i => scalarFuture s (ω i)

lemma future_measurable {N : ℕ} (s : ℝ≥0) : Measurable (future (N := N) s) :=
  measurable_pi_iff.mpr (fun i => (scalarFuture_measurable s).comp (measurable_pi_apply i))

/-- The vector future retains the literal product Wiener law. -/
theorem future_map {N : ℕ} (s : ℝ≥0) : (law N).map (future s) = law N := by
  have hprob : IsProbabilityMeasure (pathLaw.map (scalarFuture s)) :=
    (hasLaw_map (scalarFuture_measurable s).aemeasurable).isProbabilityMeasure_iff.mp inferInstance
  change (Measure.pi (fun _ : Fin N => pathLaw)).map
    (fun ω i => scalarFuture s (ω i)) = Measure.pi (fun _ : Fin N => pathLaw)
  rw [Measure.pi_map_pi (fun _ => (scalarFuture_measurable s).aemeasurable)]
  simp only [scalarFuture_map]

/-- The future path map is genuinely measure preserving. -/
theorem future_measurePreserving {N : ℕ} (s : ℝ≥0) :
    MeasurePreserving (future (N := N) s) (law N) (law N) :=
  ⟨future_measurable s,future_map s⟩

/-- Independence of the full vector future from every coordinate's past. -/
theorem future_indep_past {N : ℕ} (s : ℝ≥0) :
    IndepFun (future (N := N) s)
      (fun (ω : Space N) (i : Fin N) (u : Iic s) => coordinate i u ω) (law N) := by
  apply product_vectors_independent (fun _ : Fin N => pathLaw)
    (fun _ => scalarFuture s) (fun _ (ω : Path) (u : Iic s) => ω u)
  · exact fun _ => scalarFuture_measurable s
  · exact fun _ => measurable_pi_iff.mpr (fun u => scalar_eval_measurable u)
  · exact fun _ => scalarFuture_indep_past s

/-- Independence from the actual complete natural filtration at the waiting time. -/
theorem future_indep_filtration {N : ℕ} (s : ℝ≥0) :
    Indep (MeasurableSpace.comap (future (N := N) s) inferInstance)
      (filtration N s) (law N) := by
  have htranspose : Measurable (fun (f : Fin N → Iic s → ℝ) (u : Iic s) j => f j u) :=
    measurable_pi_iff.mpr (fun u => measurable_pi_iff.mpr
      (fun j => (measurable_pi_apply u).comp (measurable_pi_apply j)))
  have h := (future_indep_past (N := N) s).comp measurable_id htranspose
  rw [filtration, Filtration.natural_eq_comap]
  exact (IndepFun_iff_Indep _ _ _).mp h

end SphericalAging.BrownianFuturePath
