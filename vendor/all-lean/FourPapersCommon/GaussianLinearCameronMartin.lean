module

public import StochasticCalculus.CameronMartinTheorem

@[expose] public section

/-! Borel Cameron--Martin formula for the covariance shift generated by an
actual continuous linear observable of a centered Gaussian measure. -/
noncomputable section
open Set Function Filter MeasureTheory ProbabilityTheory
open scoped Topology
namespace FourPapersCommon
open StochasticCalculus
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
  [MeasurableSpace E] [BorelSpace E] [SecondCountableTopology E]
set_option maxHeartbeats 1000000
set_option backward.isDefEq.respectTransparency false

def gaussianLinearCovarianceShift (μ : Measure E) (L : E→L[ℝ]ℝ) : E :=
  ∫x,L x • x ∂μ

def gaussianLinearSecondMoment (μ : Measure E) (L : E→L[ℝ]ℝ) : ℝ :=
  ∫x,(L x)^2 ∂μ

theorem gaussianLinearCovarianceShift_eq_inclusion (μ : Measure E) [IsGaussian μ]
    (hmean : (∫x,x ∂μ)=0) (L : E→L[ℝ]ℝ) :
    gaussianLinearCovarianceShift μ L=
      CameronMartin.inclusion μ (CameronMartin.ofDual μ L) := by
  rw [CameronMartin.inclusion_apply]
  apply integral_congr_ae
  have hfield:=CameronMartin.centeredDualToLp_ae_eq μ L
  filter_upwards [hfield] with x hx
  simp only [CameronMartin.coe_ofDual,CameronMartin.centeredId,Pi.sub_apply,id_eq,
    CameronMartin.mean,hmean,map_zero,sub_zero] at hx ⊢
  exact congrArg (fun a : ℝ=>a • x) hx.symm

theorem gaussianLinearSecondMoment_eq_chaos_norm (μ : Measure E) [IsGaussian μ]
    (hmean : (∫x,x ∂μ)=0) (L : E→L[ℝ]ℝ) :
    gaussianLinearSecondMoment μ L=‖CameronMartin.ofDual μ L‖^2 := by
  have hz : (∫x,L x ∂μ)=0:=by
    rw [IsGaussian.integral_dual L,hmean,map_zero]
  have hfield : ((CameronMartin.ofDual μ L : CameronMartin.Space μ) : Lp ℝ 2 μ)
      =ᵐ[μ] fun x=>L x := by
    simpa only [CameronMartin.mean,CameronMartin.coe_ofDual,hmean,map_zero,sub_zero] using
      CameronMartin.centeredDualToLp_ae_eq μ L
  rw [gaussianLinearSecondMoment,←variance_of_integral_eq_zero L.measurable.aemeasurable hz,
    ←variance_congr hfield,CameronMartin.variance_coe_eq_norm_sq]

theorem gaussian_linear_cameronMartin_borel (μ : Measure E) [IsGaussian μ]
    (hmean : (∫x,x ∂μ)=0) (L : E→L[ℝ]ℝ) (F : E→ℝ) (hF : Measurable F) :
    (∫x,F (x+gaussianLinearCovarianceShift μ L) ∂μ)=
      ∫x,F x*Real.exp (L x-gaussianLinearSecondMoment μ L/2) ∂μ := by
  let a:=CameronMartin.ofDual μ L
  have hfield : (a : Lp ℝ 2 μ)=ᵐ[μ] fun x=>L x:=by
    simpa only [a,CameronMartin.mean,CameronMartin.coe_ofDual,hmean,map_zero,sub_zero] using
      CameronMartin.centeredDualToLp_ae_eq μ L
  rw [gaussianLinearCovarianceShift_eq_inclusion μ hmean L]
  have H : (∫x,F (x+CameronMartin.inclusion μ a) ∂μ)=
      ∫x,F x*Real.exp ((a : Lp ℝ 2 μ) x-‖a‖^2/2) ∂μ := by
    calc
      _ = ∫x,F x ∂CameronMartin.translated μ a := by
        rw [CameronMartin.translated,translatedMeasure,
          integral_map (measurable_translate _).aemeasurable hF.aestronglyMeasurable]
        rfl
      _ = _ := by
        rw [CameronMartin.translated_eq_withDensity,
          integral_withDensity_eq_integral_toReal_smul
            (CameronMartin.measurable_density μ a)
            (.of_forall fun x=>(CameronMartin.density_ne_top μ a x).lt_top)]
        apply integral_congr_ae
        exact .of_forall fun x=>by
          change (CameronMartin.density μ a x).toReal • F x=
            F x*Real.exp ((a : Lp ℝ 2 μ) x-‖a‖^2/2)
          rw [CameronMartin.density_toReal,smul_eq_mul,mul_comm]
          rfl
  refine H.trans (integral_congr_ae ?_)
  filter_upwards [hfield] with x hx
  rw [hx,gaussianLinearSecondMoment_eq_chaos_norm μ hmean L]

theorem gaussian_linear_exponential_shift (μ : Measure E) [IsGaussian μ]
    (hmean : (∫x,x ∂μ)=0) (L : E→L[ℝ]ℝ) (F : E→ℝ) (hF : Measurable F) :
    (∫x,F x*Real.exp (L x) ∂μ)=
      Real.exp (gaussianLinearSecondMoment μ L/2)*
        ∫x,F (x+gaussianLinearCovarianceShift μ L) ∂μ := by
  rw [gaussian_linear_cameronMartin_borel μ hmean L F hF,←integral_const_mul]
  apply integral_congr_ae
  exact .of_forall fun x=>by
    change F x*Real.exp (L x)=Real.exp (gaussianLinearSecondMoment μ L/2)*
      (F x*Real.exp (L x-gaussianLinearSecondMoment μ L/2))
    rw [mul_left_comm,←Real.exp_add]
    congr 2
    ring

end FourPapersCommon
